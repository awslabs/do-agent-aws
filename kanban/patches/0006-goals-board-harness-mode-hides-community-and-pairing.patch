index 0000000..e29673c
--- /dev/null
+++ b/packages/web-core/src/shared/lib/harnessMode.ts
@@ -0,0 +1,6 @@
+// do-agent-aws Goals board (kanban/patches/0006): this fork's build is the do-agent-aws harness's board, and harness
+// mode is on in it. It hides vibe-kanban's community and remote-service entry points: the GitHub star and Discord
+// links and Pair a remote device in the app bar, and Give Feedback. Machine settings stay. A build with
+// VITE_DO_AGENT_AWS_HARNESS=off shows them again.
+export const DO_AGENT_AWS_HARNESS_MODE =
+  import.meta.env.VITE_DO_AGENT_AWS_HARNESS !== 'off';
