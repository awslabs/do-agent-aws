+// do-agent-aws Goals board (kanban/patches/0008): each inserted row's POST as the board server answered it. A comment
+// box waits for this, not for the row to come back through its shape: that can wait for a long-poll to end.
+type ServerWrite = {
+  promise: Promise<void>;
+  resolve: () => void;
+  reject: (error: unknown) => void;
+  waited?: boolean;
+};
+const serverWrites = new Map<string, ServerWrite>();
+
+function serverWrite(id: string): ServerWrite {
+  let write = serverWrites.get(id);
+  if (!write) {
+    let resolve: () => void = () => undefined;
+    let reject: (error: unknown) => void = () => undefined;
+    const promise = new Promise<void>((res, rej) => {
+      resolve = res;
+      reject = rej;
+    });
+    // a write nobody waits for must not be an unhandled rejection
+    promise.catch(() => undefined);
+    write = { promise, resolve, reject };
+    serverWrites.set(id, write);
+  }
+  return write;
+}
+
+function settleServerWrite(id: string, error?: unknown): void {
+  const write = serverWrite(id);
+  if (error === undefined) {
+    write.resolve();
+  } else {
+    write.reject(error);
+  }
+  // nobody asked for it within a minute: drop it
+  if (!write.waited) {
+    setTimeout(() => {
+      if (!write.waited) serverWrites.delete(id);
+    }, 60_000);
+  }
+}
+
+/** Resolves when the board server has accepted the insert of row <id>; rejects with its error. */
+export function serverWriteOf(id: string): Promise<void> {
+  const write = serverWrite(id);
+  write.waited = true;
+  return write.promise.finally(() => serverWrites.delete(id));
+}
+
+// do-agent-aws Goals board (kanban/patches/0008): the writes in flight. While there is one, leaving the page asks
+// first: a write the page has not finished sending is lost with it (a comment's POST waited 20 s behind the shapes'
+// long-polls)
+let pendingWrites = 0;
+
+function onBeforeUnloadWhileWriting(event: BeforeUnloadEvent): void {
+  event.preventDefault();
+  event.returnValue = '';
+}
+
+async function trackWrite<T>(write: () => Promise<T>): Promise<T> {
+  if (pendingWrites++ === 0) {
+    window.addEventListener('beforeunload', onBeforeUnloadWhileWriting);
+  }
+  try {
+    return await write();
+  } finally {
+    if (--pendingWrites === 0) {
+      window.removeEventListener('beforeunload', onBeforeUnloadWhileWriting);
+    }
+  }
