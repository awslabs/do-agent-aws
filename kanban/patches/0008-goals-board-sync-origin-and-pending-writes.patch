index 0000000..095b0c3
--- /dev/null
+++ b/packages/web-core/src/shared/lib/electric/syncOrigin.ts
@@ -0,0 +1,143 @@
+/**
+ * do-agent-aws Goals board (kanban/patches/0008): the origin the board's Electric long-polls go to.
+ *
+ * Every live shape holds a long-poll open, and on HTTP/1.1 a browser opens at most six connections to one host: with
+ * six live shapes, every other request of the page (its reads, its writes, a token refresh) waited for one of them to
+ * end, up to 20 s and more. A host that serves the shapes from a second origin names it in
+ * <meta name="harness-sync-origin" content="//host[:port]">; the live requests (live=true, the long-polls) then go
+ * there, so they fill that host's connections and never the board's own. A shape's first and catch-up requests answer
+ * at once and stay on the board's origin, so a shape that opens later (a card's comments) loads at once too.
+ *
+ * Without the meta, or with a value that is not an origin alone, nothing changes. A network error on the sync origin
+ * is retried there twice, after 0.5 s and 1 s (a network change aborts every request in flight); a third failure is
+ * the shape's own: it switches to its fallback, short reads on the board's origin every 30 s, so a long-poll never
+ * holds one of the board's own connections. An answer without the Electric headers means a sync origin that does
+ * not serve them: the page leaves it for good, and the long-polls go to the board's origin.
+ */
+
+const META_NAME = 'harness-sync-origin';
+const SHAPE_PATH_PREFIX = '/v1/shape/';
+// an origin alone: //host[:port] or http(s)://host[:port], no path, query, fragment or credentials
+const ORIGIN_ONLY = /^(?:https?:)?\/\/[^/?#@\s]+\/?$/i;
+
+// a network error on the sync origin is retried after these delays, then it is the shape's own
+const RETRY_DELAYS_MS = [500, 1000];
+
+let syncOrigin: string | null | undefined;
+
+function readSyncOrigin(): string | null {
+  if (typeof document === 'undefined' || typeof window === 'undefined') {
+    return null;
+  }
+  const value = document
+    .querySelector(`meta[name="${META_NAME}"]`)
+    ?.getAttribute('content')
+    ?.trim();
+  if (!value) return null;
+  if (!ORIGIN_ONLY.test(value)) {
+    console.warn(
+      `[sync-origin] ignored ${META_NAME} "${value}": not an origin`
+    );
+    return null;
+  }
+  try {
+    const origin = new URL(value, window.location.href).origin;
+    return origin === window.location.origin ? null : origin;
+  } catch {
+    return null;
+  }
+}
+
+function getSyncOrigin(): string | null {
+  if (syncOrigin === undefined) {
+    syncOrigin = readSyncOrigin();
+  }
+  return syncOrigin;
+}
+
+function abandonSyncOrigin(reason: string): void {
+  if (!syncOrigin) return;
+  console.warn(
+    `[sync-origin] ${syncOrigin} failed (${reason}); the board's shapes use its own origin from now on`
+  );
+  syncOrigin = null;
+}
+
+function waitOrAbort(ms: number, init?: RequestInit): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const signal = init?.signal;
+    if (signal?.aborted) {
+      reject(new DOMException('Aborted', 'AbortError'));
+      return;
+    }
+    const timer = setTimeout(resolve, ms);
+    signal?.addEventListener(
+      'abort',
+      () => {
+        clearTimeout(timer);
+        reject(new DOMException('Aborted', 'AbortError'));
+      },
+      { once: true }
+    );
+  });
+}
+
+function isAbort(error: unknown, init?: RequestInit): boolean {
+  return (
+    (error instanceof DOMException && error.name === 'AbortError') ||
+    Boolean(init?.signal?.aborted)
+  );
+}
+
+/**
+ * The URL a shape request goes to on the sync origin, or null when it stays where it is: no sync origin, not a
+ * request to the board's own origin, not a shape, or not a live request.
+ */
+export function toSyncOriginUrl(input: RequestInfo | URL): string | null {
+  const origin = getSyncOrigin();
+  if (!origin || (typeof input === 'object' && !(input instanceof URL))) {
+    return null;
+  }
+  let url: URL;
+  try {
+    url = new URL(input.toString(), window.location.href);
+  } catch {
+    return null;
+  }
+  if (
+    url.origin !== window.location.origin ||
+    !url.pathname.startsWith(SHAPE_PATH_PREFIX) ||
+    url.searchParams.get('live') !== 'true'
+  ) {
+    return null;
+  }
+  return `${origin}${url.pathname}${url.search}`;
+}
+
+/**
+ * Fetch a live shape request on the sync origin. Resolves with its answer, or with null when the request is to go to
+ * the board's own origin instead (the sync origin is left then); throws an abort, and the third network error.
+ */
+export async function fetchOnSyncOrigin(
+  url: string,
+  init?: RequestInit
+): Promise<Response | null> {
+  for (let attempt = 0; ; attempt++) {
+    try {
+      const response = await fetch(url, init);
+      if (!response.ok) {
+        return response;
+      }
+      if (!response.headers.has('electric-offset')) {
+        abandonSyncOrigin('its answer does not expose the Electric headers');
+        return null;
+      }
+      return response;
+    } catch (error) {
+      if (isAbort(error, init) || attempt >= RETRY_DELAYS_MS.length) {
+        throw error;
+      }
+      await waitOrAbort(RETRY_DELAYS_MS[attempt] ?? 1000, init);
+    }
+  }
+}
