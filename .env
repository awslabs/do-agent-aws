#!/bin/bash
# Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
# SPDX-License-Identifier: Apache-2.0

# The harness's settings, with their defaults. Do not edit them here: put the ones you change in .env.local beside
# this file (gitignored, read at the end of this one - docs/manual/install.md "Settings"), so git pull never stops on your edits
# and still brings every new default.

# Source helper functions
source .fun

# shq <value> - a setting's value as one word of the docker options below, which run.sh (eval) and test.sh read as
# shell words: as it is when it holds only letters, digits and _ . / : , @ % + = - (every shipped value, so the options
# read as they always did), else quoted (printf %q), so a quote, a parenthesis, a semicolon or a space in a setting
# reaches the container as written and cannot end or extend the start command
shq()
{
  case "$1" in
    *[!A-Za-z0-9_./:,@%+=-]*) printf '%q' "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Proxy settings [optional] - set if your network requires a proxy to connect to the Internet
export http_proxy=
export https_proxy=
export no_proxy=localhost,127.0.0.1

# Project settings
## Target orchestrator TO=docker|compose|swarm|kubernetes|sandbox
export TO=docker
## VERBOSE - show verbose output, VERBOSE=true|false
export VERBOSE=true
## DEBUG - turn on script debugging, DEBUG=false|true
export DEBUG=false
## DRY_RUN - do not execute commands, DRY_RUN=false|true
export DRY_RUN=false

# Docker image settings
## BASE_IMAGE - your image will be built FROM this BASE_IMAGE as a starting point. Ubuntu 22.04 from Amazon ECR Public
## (Canonical's own repository there), pinned by digest so every build starts from the same bytes; the build upgrades
## its packages (Container-Root/setup.sh). To move the pin: crane digest public.ecr.aws/ubuntu/ubuntu:22.04
export BASE_IMAGE_PATH=public.ecr.aws/ubuntu/ubuntu:22.04@sha256:bea3e9ce454d8bbd1fc005efd77dd06e9ac3bcdeceb3efd9d2e0c7d6fc1a11e7
## CLAUDE_CODE_VERSION - the Claude Code client the image installs: pinned, so a build ships the client this tree was
## tested with (test the newer one, then move the pin); latest installs the newest release instead
export CLAUDE_CODE_VERSION=2.1.327
## MAINTAINER - the user who owns and maintains this image
export MAINTAINER="$(whoami)"
## DESCRIPTION - short description of what your image does
export DESCRIPTION="Agentic harness using the do-framework"
## BUILD - a user-friendly build identifier to distinguish between two images that have the same tag
export BUILD=$(date +%Y%m%d%H%M)
## REGISTRY: [optional] - Docker registry path including trailing "/". Example: registry.company.com/demo/
## Empty by default: a fresh clone builds, runs and tests the image as plain "do-agent-aws:latest" with no
## registry account involved; set it (e.g. iankoulski/ or 123456789012.dkr.ecr.us-east-1.amazonaws.com/) only
## to push.sh / pull.sh against your own registry
export REGISTRY=
if [ -n "${REGISTRY}" ]; then
  if [ "${REGISTRY: -1}" != "/" ]; then
    export REGISTRY="${REGISTRY}/"
  fi
fi
## IMAGE: <required> - Docker image name for this project. Example: myapp
export IMAGE=do-agent-aws
## VERSION: [optional] - Version tag for this Docker image. Example: v20180302
#export VERSION=v$(date +%Y%m%d)
export VERSION=latest
export TAG=$(if [ -z "${VERSION}" ]; then echo ""; else echo ":${VERSION}"; fi) 
## BUILD_MIN_FREE_GB: [optional] - build.sh refuses to start with less free disk (GB) where Docker keeps its images; the
## image and its build cache take about 30 GB (a fresh build took disk use from 2 to 29 GB). Lower it to try anyway.
export BUILD_MIN_FREE_GB=${BUILD_MIN_FREE_GB:-30}
## AGENT_UID, AGENT_GID: [optional] - the uid and gid of the agent user the container runs as (docs/manual/install.md "Container user").
## 1000:1000 by default, the uid of the rootless BuildKit daemon's socket and of a typical Linux host user; on a Linux host whose
## user has another uid, set both in .env.local and rebuild, so the files the agent writes under wd/ stay the host user's.
export AGENT_UID=${AGENT_UID:-1000}
export AGENT_GID=${AGENT_GID:-1000}
## BUILD_OPTS: [optional] - arguments for the docker image build command (--progress needs the BuildKit builder, docker buildx)
export BUILD_OPTS="--progress plain --build-arg BUILD=${BUILD} --build-arg BASE_IMAGE_PATH=${BASE_IMAGE_PATH} --build-arg CLAUDE_CODE_VERSION=${CLAUDE_CODE_VERSION} --build-arg MAINTAINER=\"${MAINTAINER}\" --build-arg DESCRIPTION=\"${DESCRIPTION}\" --build-arg http_proxy=${http_proxy} --build-arg https_proxy=${https_proxy} --build-arg no_proxy=${no_proxy} --build-arg AGENT_UID=${AGENT_UID} --build-arg AGENT_GID=${AGENT_GID}"
## The CVE scan of the built image (docs/manual/supply-chain.md "CVE scan"): ./scan.sh, run at the end of ./build.sh and on its own
## CVE_SCAN - scan the image at the end of ./build.sh, CVE_SCAN=true|false. The environment overrides the default here
## (CVE_SCAN=false ./build.sh), as BUILD_MIN_FREE_GB does: the host tests that run build.sh against a docker stub build without it
export CVE_SCAN=${CVE_SCAN:-true}
## CVE_GATE_SEVERITY - the severity (or comma-separated severities) a finding must have to fail the scan, and with it the build.
## CRITICAL (the shipped default since the image carries none - docs/manual/supply-chain.md "CVE scan"): a CRITICAL with a fix available fails the
## build, the rule of a release pipeline. EMPTY = report only: the same report, table and summary, the CRITICAL findings listed,
## nothing fails (CVE_GATE_SEVERITY= in .env.local)
export CVE_GATE_SEVERITY=CRITICAL
## CVE_IGNORE_UNFIXED - true: a finding of the gate severity without a fixed version (nothing to install today) is counted, listed
## and labelled, and does not fail the scan; false: every finding of that severity fails it
export CVE_IGNORE_UNFIXED=true
## CVE_MAX_HIGH - fail the scan when the HIGH findings (counted the same way) exceed this number; empty: HIGH is reported, not gated
export CVE_MAX_HIGH=
## CVE_DIR - where the scan writes (the default ./cve is gitignored; another directory is yours to ignore): the trivy report and its CRITICAL,HIGH table, the CycloneDX and SPDX bills
## of materials, the gate's findings, the summary, the gate-pass record and trivy's database cache (.trivy-cache; trivy refreshes
## it when it is a day old). The counts move with the database from one day to the next, so nothing here is committed: the
## the "CVE scan" section of docs/manual/supply-chain.md says how to read the result (the counts move with the vulnerability database, so it records none)
export CVE_DIR=./cve
## TRIVY - the scanner: docker runs the pinned public image TRIVY_IMAGE as a container through the Docker socket (nothing to
## install, the user's own files under CVE_DIR); any other value is run as the trivy command of this host (TRIVY=trivy in .env.local
## for a host install, which keeps its own database cache). Like every knob here but CVE_SCAN, set in .env.local, not the environment
export TRIVY=docker
## TRIVY_IMAGE - the scanner image, pinned by tag and digest (the release's index digest). To bump: the
## newest release of github.com/aquasecurity/trivy that public.ecr.aws/aquasecurity/trivy carries, its digest from
## `docker buildx imagetools inspect public.ecr.aws/aquasecurity/trivy:<tag>`
export TRIVY_IMAGE=public.ecr.aws/aquasecurity/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb
## TRIVY_TIMEOUT - trivy's own timeout for the walk of the image (the 17 GB harness image took about two minutes on a build host)
export TRIVY_TIMEOUT=30m

# Target Orchestrator (TO) Settings
## common
### CONTAINER_NAME: [optional] - Name of the Docker container including the --name switch. Example --name myapp
export CONTAINER=${IMAGE}
export CONTAINER_NAME="--name ${CONTAINER}"
### Harness UI settings - opt-in web UIs served from inside the container (see docs/manual/ui.md "Harness UIs")
### UI_START - start the enabled UIs at container startup, UI_START=false|true; when false the container behaves exactly as before
export UI_START=true
### Per-UI enable flags, honored when UI_START=true
export UI_HEADLAMP=true
export UI_HINDSIGHT=true
### HINDSIGHT_SEED - on the first start, load the default knowledge seed shipped in the image (/seed: general
### AWS, container, Claude Code agent-ops, git/PR hygiene and harness-convention notes, and starter rules) into the
### Hindsight memory banks harness-knowledge and loglearner-rules, so
### the agent's memory is useful before it has learned anything itself (/agent/hindsight-seed.sh, run by
### startup.sh after the UIs are up; a stamp on /wd makes it run once, a changed seed re-seeds, stable document
### ids make every run an update rather than a duplicate). HINDSIGHT_SEED=false skips it entirely: it seeds nothing
### more and removes nothing, so banks an earlier start seeded stay in the memory store (delete them through the
### memory API to empty it). After acceptance the seed watches the first extraction: a memory API that cannot call
### Bedrock (no credentials, no model access) is reported in /wd/ui/hindsight-seed.log, on the home page's Hindsight
### tile and by /agent/ui-status.sh (exit 1).
export HINDSIGHT_SEED=true
export UI_VIBE_KANBAN=true
### UI_CLAUDE_MEM - the claude-mem viewer (http://claude-mem.localhost:8000/): the web UI of the claude-mem
### plugin's worker - the observations, summaries and prompts it captures from every Claude Code session in
### the container. The worker is the same process the plugin's own SessionStart hook starts on demand
### (bun worker-service.cjs); ui-start.sh starts it at container start (or adopts an already running one) so
### the tile is up before the first session and stays up (CLAUDE_MEM_IDLE_EXIT_SEC=0). Memory data lives in
### /home/agent/.claude-mem (persisted agent state).
export UI_CLAUDE_MEM=true
### CLAUDE_MEM_VIEWER_WRAPPER - the harness view of the claude-mem viewer, true|false. The proxy adds a script and a
### stylesheet to the viewer's page. A prompt card that holds one of the harness's own machine prompts (the autonomy
### loop's, the Slack chat responder's) is folded into a closed "Loop instructions (machine prompt, N lines)"
### disclosure, so the human prompts, summaries and observations read first; the trial promotion and the social links
### are hidden. It works in the browser only: no stored memory changes. A note on the page says so and switches that
### browser to the stock viewer and back. false serves the stock viewer.
export CLAUDE_MEM_VIEWER_WRAPPER=true
### UI_LOGLEARNER - the LogLearner dashboard (http://loglearner.localhost:8000/): a read-only browser over the
### agent's own Claude Code sessions (/home/agent/.claude/projects) - projects, transcripts with gap overlays, the
### instinct library and a Hindsight panel. Vendored from github.com/dmvevents/loglearning (MIT) at
### /opt/loglearner; served by /agent/loglearner-serve.sh, which also keeps its sqlite index
### (/wd/loglearner/index.db) fresh and loads the seed's starter rules into its instinct bank. The
### `loglearner` command (the runtime's knowledge-pack loader) is installed alongside.
export UI_LOGLEARNER=true
### LOGLEARNER_HOOK - deliver banked rules into the agent's own Claude Code sessions, LOGLEARNER_HOOK=true|false.
### Before every Edit, Write and Bash tool call a PreToolUse hook (/agent/loglearner-hook.sh, registered in the
### agent's settings.json at build and re-synced at every start) matches the file and the command against the
### LogLearner knowledge bank (the /seed banks, loaded into it at every start) and hands the matching rules to
### the model as context; every delivery is counted in the exposure ledger. Fail-open: it always exits 0 and
### gives up after 9 s, so a tool call never fails because of it. Independent of UI_START and UI_LOGLEARNER (it
### is not a UI); false removes the hook entry at the next start. See docs/manual/memory.md "Agent learning tools".
export LOGLEARNER_HOOK=true
### AGENT_KNOWLEDGE - the default knowledge where a headless loop fire can read it, AGENT_KNOWLEDGE=true|false: at every
### start the shipped packs (/opt/loglearner-packs: the example pack gpu-cluster-basics) and the seed's general banks
### are copied to /wd/knowledge/defaults, a skill indexes every record and a marked section of the agent's CLAUDE.md
### points at them (a fire may Read and Grep; under the safe value of its options it cannot call the memory MCP tools,
### so the Hindsight banks alone never reach it). false removes the copy, the skill and the section, and a start then
### loads no shipped pack into the LogLearner bank the hook and recall.sh read, and takes out of it the records an
### earlier start loaded from one (every other record kept; the seed's general banks load either way), and recall.sh no
### longer searches the Hindsight banks a shipped pack's manifest covers (hindsight_banks; the example pack names none).
### See docs/manual/memory.md "Agent learning tools".
export AGENT_KNOWLEDGE=true
### AGENT_MEMORY - Claude Code's own memory, AGENT_MEMORY=true|false: the MEMORY.md index and the fact files the agent
### writes for itself and loads at the start of every session, one directory per working directory under the persisted
### agent state (/home/agent/.claude/projects/<slug>/memory; a fire's and the pane's is the /wd one). On by default in Claude
### Code; the harness writes the setting (autoMemoryEnabled in the agent's settings.json, /agent/claude-memory-settings.py
### at every start) so that a state created by an older image, or a default that changes, follows this knob. false turns
### it off at the next start. See docs/manual/memory.md "Agent memory".
export AGENT_MEMORY=true
### AGENT_OVERLAY - the operator's overlay, AGENT_OVERLAY=true|false: the standing instructions of THIS deployment, read by every
### fire, the chat responder and the agent's pane from /wd/CLAUDE.md (their working directory). With true (the default) a start
### that finds no /wd/CLAUDE.md writes a short stub there that says the overlay is not filled yet and where the example is
### (/agent/CLAUDE.md.example, docs/parity/CLAUDE.md.example in the checkout); a file that exists is never touched. false
### writes nothing. See docs/manual/autonomy.md "Parity with a native instance".
export AGENT_OVERLAY=true
### AGENT_SKILLS_PACK - the skills imported from a native instance's library (docs/parity/SKILLS-PACK.md, 35 under
### /agent/skills beside the harness's own two), AGENT_SKILLS_PACK=true|false: true (the default) syncs them into the agent's
### Claude configuration at every start with the harness's own skills; false leaves them out and removes the copies an
### earlier start made (the harness's own skills stay). See docs/manual/autonomy.md "Parity with a native instance".
export AGENT_SKILLS_PACK=true
### LOGLEARNER_S3_BUCKET - a shared knowledge base for a group of harnesses [optional; empty: off]: at every start
### /agent/loglearner-packs.sh pulls one LogLearner pack from s3://<bucket>/<LOGLEARNER_S3_PREFIX>/<LOGLEARNER_PACK>/,
### the version LOGLEARNER_PACK_VERSION names (or its latest.json does), checks its sha256 against the version's
### manifest.json and loads its instincts.jsonl after the default knowledge (a mismatch leaves the bank as it is, the
### same version again is a no-op, nothing is ever written to S3). Read with the container's own AWS access ("AWS
### credentials"). Empty prefix, pack and version: the pull's defaults (loglearner/packs, aws-default, latest). The
### layout and how a group publishes a pack there: docs/manual/memory.md "A shared knowledge base for a group".
export LOGLEARNER_S3_BUCKET=""
export LOGLEARNER_S3_PREFIX=""
export LOGLEARNER_PACK=""
export LOGLEARNER_PACK_VERSION=""
### UI_LOOP_DECK - the Loop Deck tile and its route (loop-deck.localhost): the Deck shipped in the image (/opt/loop-deck) in
### harness mode over the records this harness writes for its own loops (/wd/loop-deck). Actions are off (every POST /act
### answers 403). false: no Deck process, the tile greyed. LOOP_DECK_URL (below) links a fleet Deck instead of the served one.
export UI_LOOP_DECK=true
### UI_LOOP - the Agent loop page (http://loop.localhost:8000/): the autonomy loop at a glance - whether it runs and its
### health, its fires with their exit code, duration and transcript, the goals open and done, what needs attention, and
### the fleet it runs in (the operator, the agent's terminal sessions, the loop and its fires with the sub-agents they
### spawned, the services beside it). /agent/loop-view.py renders it from the loop's state files; the page's only
### actions are Run next fire and Pause loop (UI_LOOP_CONTROL below), and it lists the commands to copy. See
### docs/manual/ui.md "Agent loop page".
export UI_LOOP=true
### UI_LOOP_CONTROL - the Agent loop page's Control section: Run next fire (/agent/loop-start.sh: removes the STOP flag
### and starts the loop) and Pause loop (/agent/loop-stop.sh: sets the STOP flag; the loop halts before its next fire).
### Each answers with the loop's state read back afterwards. POST only, from the page's own origin; false turns both
### off and leaves the page read-only (its commands to copy stay).
export UI_LOOP_CONTROL=true
### UI_PLANE - the self-hosted Plane project-management board, run by ./run.sh as sidecar containers and served at
### plane.localhost through the home port, signed in already and mirroring the agent's goals (docs/manual/boards.md "Plane board").
### OPTIONAL, OFF BY DEFAULT: Plane community edition (the public makeplane/*:v1.4.2 images) is licensed under the
### AGPL-3.0, not this repository's Apache-2.0. Off, nothing of Plane is pulled by ./build.sh, started by ./run.sh or
### shown on the home page: no Plane tile, no Board tile (the Board reads the Plane project), no plane.localhost route.
### If the AGPL-3.0 is acceptable to you: export UI_PLANE=true in .env.local (never in .env), then ./build.sh (pulls
### its ten images: Plane's six under the AGPL-3.0, four datastores under their own licenses) and ./run.sh - on a running
### instance ./stop.sh && ./run.sh - which starts its twelve sidecars; docs/manual/boards.md "Plane board" says what then appears
export UI_PLANE=false
### UI_BOARD - the Board (http://board.localhost:8000/): a read-only kanban view of this harness's own Plane project -
### its columns and cards, with the agent runner's attempts on the cards they belong to - served from inside the
### container (/agent/board-server.py, stdlib python, loopback only). It reads the project with the agent's API key from
### wd/plane/plane.env and never writes; it runs only while the Plane board does (UI_PLANE=true, docker target): with
### the Plane board off there is no Board tile either; with it on, UI_BOARD=false greys the tile and a target without
### the sidecars says so. See docs/manual/boards.md "Board".
export UI_BOARD=true
### UI_FILES - the Files tile (http://files.localhost:8000/): the shared folder between you and the agent, served from
### inside the container (/agent/files-server.py, stdlib python, loopback only) - download what the agent saved for
### you, upload files for it to read, make folders, rename, move and delete (a confirm before anything is removed or
### replaced). The folder is FILES_DIR below, on the /wd volume: persisted with the agent's data on the docker target,
### an emptyDir gone with the pod on kubernetes. On by default. See docs/manual/ui.md "Files".
export UI_FILES=true
### FILES_DIR - the shared folder as the agent container sees it (the agent writes its deliverables there and reads
### what you upload); FILES_MAX_UPLOAD_MB - the largest upload the page and the home proxy accept, in MiB (1024 = 1 GiB)
export FILES_DIR=/wd/files
export FILES_MAX_UPLOAD_MB=1024
### UI_HOME - the harness home page + reverse proxy (nginx). One page at / lists every enabled
### UI and every UI is proxied through this single port, so docker publishes (and kubernetes
### exposes) ONE port for the whole harness. See docs/manual/ui.md "Home page and reverse proxy".
export UI_HOME=true
### UI_HOME_HOSTNAMES - extra host names the home listener answers for, comma-separated (e.g.
### agent.internal). It always answers localhost, 127.0.0.1 and [::1] - the names an SSH tunnel or
### kubectl port-forward puts in the browser - and refuses any other Host with 421, so a DNS-rebinding
### page cannot reach the writable terminal or the memory API through the proxy. Only needed when the
### home port is reached under another name on purpose.
export UI_HOME_HOSTNAMES=
### UI_HOME_ALLOW_FROM - extra source addresses or CIDRs allowed to CONNECT to the home listener inside the
### container, comma-separated: IPv4 (/8-/32, octets 0-255) or IPv6 (/16-/128), never /0. It always allows
### loopback and the container's DEFAULT-ROUTE gateway read from the routing table (IPv4; where Docker's
### published-port forward arrives from - the default bridge's, or a sidecar stack's user-defined network's;
### /agent/home-route-watch.sh re-renders when the default route moves, e.g. after `docker network connect` on
### the running container; UI_HOME_GATEWAY overrides the detection). Never an address derived from a subnet:
### everything else is answered 403, so a neighbour container on any attached network reaches nothing. Add a
### source only when a reverse proxy or another container must reach the home port directly.
export UI_HOME_ALLOW_FROM=
### UI_TMUX - browser terminal (ttyd) attached to the container's shared tmux session
### (tmux new-session -A -s agent), proxied at /tmux/ - watch and drive the agent from the
### browser. WRITABLE by default - keystrokes typed at /tmux/ reach the agent session; set
### UI_TMUX_WRITABLE=false for a watch-only terminal (it also starts the tmux-agent dashboard below
### read-only: its send box types into the same sessions - and turns the Agent chat page's send box off).
export UI_TMUX=true
export UI_TMUX_WRITABLE=true
### UI_CHAT - the Agent chat page (http://chat.localhost:8000/): talk to the agent without Slack. The page shows the
### shared agent tmux session's screen (the same session the browser terminal shows), refreshed every two seconds, and
### a box that types a message at the agent's prompt and submits it. Its acknowledgement is the transport only - the
### text was typed and submitted - never a claim about what the agent did; the screen shows that. Served by
### /agent/agent-chat.py on 127.0.0.1 inside the container and reached through the home proxy only (no direct publish):
### a message is accepted by POST only, from the page's own origin only, capped at 4000 characters with every control
### character replaced, typed only while the pane's foreground command is the agent CLI (a shell is refused), and never
### through a shell here (docs/manual/ui.md "Agent chat"). false = no backend, no route, a greyed tile.
export UI_CHAT=true
### UI_TMUX_AGENT - the tmux-agent web dashboard (/tmux-agent/): fleet tree, history and waste of
### tmux-run agents. On by default: the image ships a prebuilt copy of the dashboard
### (github.com/dmvevents/tmux-agent-public, Apache-2.0, vendored with its LICENSE and NOTICE at
### /opt/tmux-agent - see Container-Root/opt/tmux-agent/VENDORED.md for the upstream commit), so
### the tile works offline out of the box. /agent/ui-start.sh serves it loopback-only behind the home
### proxy. See docs/manual/ui.md "tmux-agent dashboard".
export UI_TMUX_AGENT=true
### TMUX_AGENT_SRC - where the dashboard is built from. EMPTY (the default): the copy vendored in the image is served
### (/opt/tmux-agent, built from its lockfile and reviewed with the image - Container-Root/opt/tmux-agent/VENDORED.md);
### nothing is fetched or built at start. Set it to build a source of your own at the first start instead - the
### upstream repository, export TMUX_AGENT_SRC=https://github.com/dmvevents/tmux-agent-public.git, or any git URL or a
### path visible inside the container: /agent/ui-start.sh then runs /agent/install-tmux-agent.sh (git fetch of
### TMUX_AGENT_REF, npm ci, npm run build into TMUX_AGENT_INSTALL_DIR on the /wd volume, so later starts skip the build;
### that first start needs github.com and registry.npmjs.org), and the tile says "built from TMUX_AGENT_SRC". Only a
### credential-free https URL may be written here (test14 enforces it): a token URL must never land in this file, the
### docker command line or a rendered manifest - export it in the host shell before ./run.sh instead, the bare -e
### below passes it through (the SLACK_BOT_TOKEN pattern).
export TMUX_AGENT_SRC=${TMUX_AGENT_SRC:-}
### TMUX_AGENT_REF - branch, tag or commit to build from TMUX_AGENT_SRC, PINNED to the public repository's
### root commit; move the pin deliberately (a changed ref or source re-builds on the next start).
export TMUX_AGENT_REF=92113b54b755cffc7666c0f475cb706b38d9ade9
### TMUX_AGENT_INSTALL_DIR - the TMUX_AGENT_SRC checkout + build inside the container; under /wd/ui, with the
### other UIs' state on the /wd volume, so it survives restarts and is never taken for one of your repositories:
### the starter repository step and the agent runner's repository list take a git repository directly under /wd
### for yours. (Not TMUX_AGENT_HOME: that is the dashboard's own state directory.)
export TMUX_AGENT_INSTALL_DIR=/wd/ui/tmux-agent
### UI_PUBLISH_DIRECT_PORTS - opt-in: with the home proxy on, ALSO publish each UI's own port
### directly on UI_BIND_HOST (the pre-home behavior), for debugging or for a UI the proxy
### cannot carry. Default false: the home port is the only published port.
export UI_PUBLISH_DIRECT_PORTS=false
### UI_BIND_HOST - host-side interface the UI ports are published on. Keep 127.0.0.1 and reach the
### UIs through an SSH tunnel (ssh -L <port>:localhost:<port> user@host); never publish on all interfaces.
export UI_BIND_HOST=127.0.0.1
### Per-UI port pairs - internal (inside the container) and external (published on UI_BIND_HOST)
export PORT_INTERNAL_HOME=8000
export PORT_EXTERNAL_HOME=8000
export PORT_INTERNAL_HEADLAMP=4466
export PORT_EXTERNAL_HEADLAMP=4466
export PORT_INTERNAL_HINDSIGHT_API=8888
export PORT_EXTERNAL_HINDSIGHT_API=8888
export PORT_INTERNAL_HINDSIGHT_UI=9999
export PORT_EXTERNAL_HINDSIGHT_UI=9999
export PORT_INTERNAL_VIBE_KANBAN=8081
export PORT_EXTERNAL_VIBE_KANBAN=8081
export PORT_INTERNAL_TMUX=7681
export PORT_EXTERNAL_TMUX=7681
export PORT_INTERNAL_TMUX_AGENT=7337
export PORT_EXTERNAL_TMUX_AGENT=7337
### 37700 is the claude-mem worker's own default port (its hooks look for the worker there). These four UIs
### bind 127.0.0.1 inside the container and are reached through the home proxy only (no direct publish)
export PORT_INTERNAL_CLAUDE_MEM=37700
export PORT_INTERNAL_LOGLEARNER=7777
### PORT_INTERNAL_BOARD - the in-container loopback port of the Board (never published; the home proxy serves it)
export PORT_INTERNAL_BOARD=8096
### PORT_INTERNAL_FILES - the in-container loopback port of the Files tile's server (never published; the home proxy serves it)
export PORT_INTERNAL_FILES=8098
export PORT_INTERNAL_CHAT=8094
export PORT_INTERNAL_LOOP=7790
### Kanban board settings - the self-hosted vibe-kanban board served at kanban.localhost (see docs/manual/boards.md "Kanban
### board"), on with UI_VIBE_KANBAN=true. ./build.sh builds its server image from the public upstream source at a
### pinned commit plus the vendored patch in kanban/ (./kanban.sh build); ./run.sh runs that server, Electric and
### Postgres as three sidecar containers on their own network, which the agent container joins; ./stop.sh removes
### them and keeps the board's data volumes. No sidecar publishes a host port: the board is reached only through
### the home proxy. The agent's autonomy loop mirrors its goals and fires on the board (/agent/kanban-sync.py).
### KANBAN_VK_REPO / KANBAN_VK_SHA - upstream source and pinned commit (v0.1.44, the last release); the patch in
### kanban/patches/ is checked against exactly this commit before it is applied
export KANBAN_VK_REPO=https://github.com/BloopAI/vibe-kanban.git
export KANBAN_VK_SHA=4deb7eca8f381f7cbc1f9d15515a9ab8f8009053
### KANBAN_SRC_DIR - the upstream checkout the image is built from (gitignored; reset to the pin on every build)
export KANBAN_SRC_DIR=./kanban/src
### KANBAN_IMAGE - the board server image, built locally next to the agent image
export KANBAN_IMAGE=${REGISTRY}${IMAGE}-kanban${TAG}
### KANBAN_BUILD_OPTS - arguments for its docker image build command
export KANBAN_BUILD_OPTS="--progress plain --build-arg http_proxy=${http_proxy} --build-arg https_proxy=${https_proxy} --build-arg no_proxy=${no_proxy}"
### KANBAN_BUILD_BASES - the base images of the upstream Dockerfiles at KANBAN_VK_SHA (the board's and the relay's),
### <FROM name>=<image by digest> each: kanban.sh build passes each as a --build-context, so the build takes the same
### official image from ECR Public by its digest while the Dockerfiles stay upstream's; a base image without a pin here
### fails the build (kanban.sh base_args). KANBAN_BUILD_SYNTAX - their # syntax= frontend, by digest (Docker Hub, the
### only registry that serves it)
export KANBAN_BUILD_BASES="node:20-alpine=public.ecr.aws/docker/library/node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 rust:1.93-slim-bookworm=public.ecr.aws/docker/library/rust:1.93-slim-bookworm@sha256:5b9332190bb3b9ece73b810cd1f1e9f06343b294ce184bcb067f0747d7d333ea debian:bookworm-slim=public.ecr.aws/docker/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc"
export KANBAN_BUILD_SYNTAX=docker/dockerfile:1.6@sha256:ac85f380a63b13dfcefa89046420e1781752bab202122f8f50032edf31be0021
### KANBAN_POSTGRES_IMAGE / KANBAN_ELECTRIC_IMAGE - the two public sidecar images at upstream's versions, by digest: the
### database the official image from ECR Public, Electric from Docker Hub (the only registry that serves it)
export KANBAN_POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16-alpine@sha256:81e77a4833487b8132fe4b00bedd39dc3f74b8641e387f19312a48f7de218c2e
export KANBAN_ELECTRIC_IMAGE=electricsql/electric:1.4.13@sha256:b9a7746d7c9b87b75be609fc69df7ea0a564414eddcdfc44118bcccb90a1a885
### Sidecar network, container and volume names (docker target), derived from CONTAINER. KANBAN_NETWORK is the
### agent container's network with the board server; KANBAN_INTERNAL_NETWORK, internal (no route out), is the board
### server's with the database and Electric. The containers answer to kanban-server, kanban-db and kanban-electric
### there, the compose target's service names
export KANBAN_NETWORK=${CONTAINER}-kanban
export KANBAN_INTERNAL_NETWORK=${CONTAINER}-kanban-internal
export KANBAN_DB_NAME=${CONTAINER}-kanban-db
export KANBAN_ELECTRIC_NAME=${CONTAINER}-kanban-electric
export KANBAN_SERVER_NAME=${CONTAINER}-kanban-server
export KANBAN_DB_VOLUME=${CONTAINER}-kanban-db
export KANBAN_ELECTRIC_VOLUME=${CONTAINER}-kanban-electric
### UI_KANBAN_RELAY - the upstream relay server, so the board can open the agent runner as its host and start a
### workspace from a card, UI_KANBAN_RELAY=false|true [default false] (docs/manual/boards.md "Kanban board", the relay). true:
### ./build.sh also builds the relay image from the same pinned source (one more Rust build) and the board image with
### kanban/patches-relay/ (Pair a remote device shown); ./run.sh starts the relay as a fourth sidecar, kanban-relay
### (no published port), the agent runner starts with the board as its shared API, signed in to it with the board
### login (stored before it starts), so it registers with the relay as the board's host, and the home proxy sends
### kanban.localhost/v1/relay/ to the relay. Pairing a browser with the host is one manual step (README). false: the
### build and the start are as without it. The docker and compose targets.
export UI_KANBAN_RELAY=false
### KANBAN_RELAY_IMAGE / KANBAN_RELAY_NAME - the relay server image, built locally, and its sidecar container
export KANBAN_RELAY_IMAGE=${REGISTRY}${IMAGE}-kanban-relay${TAG}
export KANBAN_RELAY_NAME=${CONTAINER}-kanban-relay
### KANBAN_DIR - host folder of the board login: kanban.env (mode 600: the login email, a random password and the
### server secrets, generated on the first ./run.sh) and the env files derived from it. Under wd/, so it is
### gitignored and visible to the agent at /wd/kanban; never printed by any script.
export KANBAN_DIR=$(pwd)/wd/kanban
### PORT_INTERNAL_KANBAN_BOARD - the board server's port inside its own container (never published)
export PORT_INTERNAL_KANBAN_BOARD=8081
### PORT_INTERNAL_KANBAN_RELAY - the relay's port inside its own container (never published)
export PORT_INTERNAL_KANBAN_RELAY=8082
### KANBAN_CARD_ORDER - the order of the goal cards within a column of the Goals board, KANBAN_CARD_ORDER=newest-first|file
### [default newest-first]. newest-first: the newest goal - the one that reached the board last - is on top of its column,
### in every column, Done included: the mirror sets each card's sort_order, which the board sorts a column by, to minus the
### time the goal first reached the board (kept in /wd/loop/kanban-sync.state, so a card's value never changes); goals that
### arrive together keep the file's order among them. file: the file's order, the oldest on top. The setting reaches the
### agent container at its start (below, with the other board settings): change it in .env.local, then ./stop.sh -s &&
### ./run.sh -s - the first sync after the start re-sorts the cards already on the board; a card dragged within its column
### keeps its place until the next sync. An empty value is the default; any other value is refused when this file is read
### (a WARNING, the default is passed) and by the mirror itself (exit 4). docs/manual/boards.md "Kanban board"
export KANBAN_CARD_ORDER=newest-first
# the check: a refused value is replaced by assignment, because on this file's second pass an export of a name .env.local
# sets keeps the .env.local value (as LOOP_DECK_URL below)
if [ -n "${KANBAN_CARD_ORDER}" ] && [ "${KANBAN_CARD_ORDER}" != "newest-first" ] && [ "${KANBAN_CARD_ORDER}" != "file" ]; then
  echo "WARNING: KANBAN_CARD_ORDER=${KANBAN_CARD_ORDER} is not newest-first or file - the default newest-first is passed" >&2
  KANBAN_CARD_ORDER=newest-first
fi
### KANBAN_BOARD_URL - the board server as the agent container reaches it (the home proxy routes kanban.localhost to
### it, the goal sync writes to it); empty while the board is off and on the targets that run no board (swarm,
### kubernetes). Computed - not usually edited by hand.
### KANBAN_RUN_OPTS - what the docker target's agent container needs to use the board: that URL, the project the goal
### sync writes, the login file it reads and the order of its cards (KANBAN_CARD_ORDER); KANBAN_RUN_NETWORK joins it to
### the board server's network (with NETWORK set, run.sh connects it after the start instead). Appended by run.sh only -
### test.sh's throwaway container has no sidecars, and there kanban.localhost serves the agent runner.
export KANBAN_BOARD_URL=""
export KANBAN_RUN_OPTS=""
export KANBAN_RUN_NETWORK=""
export KANBAN_RELAY_URL=""
if [ "${UI_START}" == "true" ] && [ "${UI_VIBE_KANBAN}" == "true" ] && [ "${TO}" != "swarm" ] && [ "${TO}" != "kubernetes" ]; then
  export KANBAN_BOARD_URL=http://kanban-server:${PORT_INTERNAL_KANBAN_BOARD}
  export KANBAN_RUN_OPTS="-e KANBAN_BOARD_URL=$(shq "${KANBAN_BOARD_URL}") -e KANBAN_PROJECT=$(shq "${CONTAINER}") -e KANBAN_AUTH_FILE=/wd/kanban/kanban.env -e KANBAN_CARD_ORDER=$(shq "${KANBAN_CARD_ORDER}")"
  export KANBAN_RUN_NETWORK="--network $(shq "${KANBAN_NETWORK}")"
  # relay on: the relay as the agent's runner reaches it (kanban-relay); off, KANBAN_RUN_OPTS is as without it
  if [ "${UI_KANBAN_RELAY}" == "true" ]; then
    export KANBAN_RELAY_URL=http://kanban-relay:${PORT_INTERNAL_KANBAN_RELAY}
    export KANBAN_RUN_OPTS="${KANBAN_RUN_OPTS} -e KANBAN_RELAY_URL=$(shq "${KANBAN_RELAY_URL}")"
  fi
fi
### Comms UI settings - communication-engine operator dashboard, a read-only
### severity-ordered view over the agent's communication channels (see docs/manual/channels.md "Comms UI"
### and docs/comms/README.md). On by default (demo mode is credential-free and offline);
### with COMMS_UI_ENABLED=false no comms code runs and no comms route is served.
export COMMS_UI_ENABLED=true
### COMMS_DEMO_SEED - on the first start only (no journal yet), seed the credential-free fake
### adapter with the engine's demo message so the dashboard renders out of the box. The seed
### only touches the fake adapter; real channels need your own settings.json + tokens.
export COMMS_DEMO_SEED=true
### COMMS_UI_WRITE_ENABLED - the engine's gated WRITE surface on the dashboard.
### On by default: composing in the UI STAGES a draft into the outbox and only an explicit
### human click on that exact text sends it - the agent/engine never auto-sends; discard is
### terminal and kept as the audit record. Independent second gate per channel: a channel
### still needs reply_policy staged|direct in settings.json (every channel defaults to
### never = deny). In demo mode the send goes to the engine's credential-free fake adapter,
### so the whole write cycle is provable offline; no shipped live adapter has a send path
### (see docs/comms/README.md "The write surface"). Set COMMS_UI_WRITE_ENABLED=false for the
### strictly read-only viewer (the engine's send layer is then never even imported -
### AST-checked upstream).
export COMMS_UI_WRITE_ENABLED=true
### COMMS_ENV_NAMES - space-separated NAMES of environment variables to pass into the
### container for the comms engine's env: auth references (docs/comms/README.md "Connect a
### real channel" and the per-channel pages). Example:
###   export COMMS_ENV_NAMES="MY_SLACK_TOKEN MY_SLACK_CHANNELS TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID"
### Each name is rendered as a bare `-e NAME` switch, so the VALUE comes from the host
### environment and never appears in this file or in the echoed docker command (the same
### pattern as SLACK_BOT_TOKEN above). NAMES only: an entry containing '=' is refused loudly
### below - a value in a names list is a leak - and so is an entry that is not a variable name
### (letters, digits and _, not starting with a digit), which would reach the docker command
### line as shell syntax. Set it here or export it in the host shell
### before ./run.sh (the ${COMMS_ENV_NAMES:-} form keeps a host-exported value; the names
### are not secrets - only the values are, and those never enter this file).
export COMMS_ENV_NAMES="${COMMS_ENV_NAMES:-}"
### COMMS_ENV_NAME_OPTS - computed from COMMS_ENV_NAMES; not edited by hand
COMMS_ENV_NAME_OPTS=""
# split on whitespace with pathname expansion off: an entry such as * or NAM? is checked as written, never as the file
# names it matches in the current directory
case $- in *f*) COMMS_ENV_NOGLOB=true ;; *) COMMS_ENV_NOGLOB=false; set -f ;; esac
for N in ${COMMS_ENV_NAMES}; do
  case "${N}" in
  *=*)
    echo "ERROR: COMMS_ENV_NAMES entries are environment-variable NAMES, never NAME=value; got '${N%%=*}=...' (value not shown). Export the value in the host shell and list only the name." >&2
    exit 1
    ;;
  [!A-Za-z_]*|*[!A-Za-z0-9_]*)
    echo "ERROR: a COMMS_ENV_NAMES entry is not an environment-variable name (letters, digits and _, not starting with a digit); the entry is not shown, in case it is a value. List only names." >&2
    exit 1
    ;;
  esac
  COMMS_ENV_NAME_OPTS="${COMMS_ENV_NAME_OPTS} -e ${N}"
done
if [ "${COMMS_ENV_NOGLOB}" == "false" ]; then
  set +f
fi
unset COMMS_ENV_NOGLOB
export COMMS_ENV_NAME_OPTS
### COMMS_WATCH_ENABLED - start the comms real-channel watcher (/agent/comms-watch-start.sh)
### at container startup, COMMS_WATCH_ENABLED=true|false. The watcher runs the engine's own
### read-only scheduler against /wd/comms/settings.json so configured real channels are
### actually polled into the journal the dashboard renders, and replies in the threads of
### open asks mark those asks answered; without it the dashboard only ever shows the demo
### seed (docs/comms/README.md "Connect a real channel"). On by default: with the generated
### demo settings it polls only the credential-free fake adapter, so it makes no network
### call; set false to run no watcher.
export COMMS_WATCH_ENABLED=true
### Comms UI port pair - internal (inside the container) and external (published on UI_BIND_HOST)
export PORT_INTERNAL_COMMS_UI=8502
export PORT_EXTERNAL_COMMS_UI=8502
### COMMS_UI_BASE_PATH - URL path the comms dashboard serves under (streamlit
### --server.baseUrlPath). Set to "comms" when the home proxy carries it so it answers at
### /comms/ through the single port; empty (the pre-home behavior, dashboard at /) when the
### proxy is off. Computed - not usually edited by hand.
export COMMS_UI_BASE_PATH=""
if [ "${UI_START}" == "true" ] && [ "${UI_HOME}" == "true" ]; then
  export COMMS_UI_BASE_PATH=comms
fi
### VOLUME_PATH_INTERNAL - mount path of volume inside the container
export VOLUME_PATH_INTERNAL=/do-agent-aws
## VOLUME_PATH_EXTERNAL - external path to mount
export VOLUME_PATH_EXTERNAL=$(pwd)
### ENVSUBST - envsubst cli. ENVSUBST=envsubst | "env > /tmp/myanv && docker run --rm -it --env-file /tmp/myenv -v $(pwd):$(pwd) iankoulski/envsubst sh -c envsubst"
export ENVSUBST=envsubst

## docker
### UI port map [optional] - loopback-bound publishes for the harness UIs, appended to PORT_MAP below.
### Empty when UI_START=false so the docker run command is unchanged from before. With the home
### proxy on (UI_HOME=true, the default) ONLY the home port is published - every UI is reached
### through it (docs/manual/ui.md "Home page and reverse proxy"); the per-UI direct publishes below
### return when UI_HOME=false (the pre-home behavior) or opt-in via UI_PUBLISH_DIRECT_PORTS=true.
export UI_PORT_MAP=""
if [ "${UI_START}" == "true" ]; then
  if [ "${UI_HOME}" == "true" ]; then
    UI_PORT_MAP="${UI_PORT_MAP} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_HOME}:${PORT_INTERNAL_HOME}"
  fi
  if [ "${UI_HOME}" != "true" ] || [ "${UI_PUBLISH_DIRECT_PORTS}" == "true" ]; then
    if [ "${UI_HEADLAMP}" == "true" ]; then
      UI_PORT_MAP="${UI_PORT_MAP} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_HEADLAMP}:${PORT_INTERNAL_HEADLAMP}"
    fi
    if [ "${UI_HINDSIGHT}" == "true" ]; then
      UI_PORT_MAP="${UI_PORT_MAP} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_HINDSIGHT_API}:${PORT_INTERNAL_HINDSIGHT_API} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_HINDSIGHT_UI}:${PORT_INTERNAL_HINDSIGHT_UI}"
    fi
    if [ "${UI_VIBE_KANBAN}" == "true" ]; then
      UI_PORT_MAP="${UI_PORT_MAP} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_VIBE_KANBAN}:${PORT_INTERNAL_VIBE_KANBAN}"
    fi
    if [ "${UI_TMUX}" == "true" ]; then
      UI_PORT_MAP="${UI_PORT_MAP} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_TMUX}:${PORT_INTERNAL_TMUX}"
    fi
    if [ "${UI_TMUX_AGENT}" == "true" ]; then
      UI_PORT_MAP="${UI_PORT_MAP} -p ${UI_BIND_HOST}:${PORT_EXTERNAL_TMUX_AGENT}:${PORT_INTERNAL_TMUX_AGENT}"
    fi
    # no direct publish for claude-mem (37700), loglearner (7777) or the Agent chat page (8094): all three bind
    # 127.0.0.1 INSIDE the container by design (the claude-mem worker's own default, the LogLearner dashboard's
    # only bind, the chat page's one bind), so a docker publish of any of these ports would never answer - they
    # are reached through the home proxy only
  fi
  export UI_PORT_MAP
fi
### Comms UI port publish - loopback only. The comms UI is one of the harness UIs, so it is
### gated by the UI_START master switch (with UI_START=false nothing UI-related runs or
### publishes - the pre-UI behavior). When on, it is published directly only when the home
### proxy will NOT carry it (UI_HOME off) or when direct ports are opted in - otherwise it
### rides the single home port at /comms/ (see docs/manual/channels.md "Comms UI").
export COMMS_UI_PORT_MAP=""
if [ "${UI_START}" == "true" ] && [ "${COMMS_UI_ENABLED}" == "true" ]; then
  if [ "${UI_HOME}" != "true" ] || [ "${UI_PUBLISH_DIRECT_PORTS}" == "true" ]; then
    COMMS_UI_PORT_MAP=" -p ${UI_BIND_HOST}:${PORT_EXTERNAL_COMMS_UI}:${PORT_INTERNAL_COMMS_UI}"
  fi
  export COMMS_UI_PORT_MAP
fi
### Port map [optional] - Mapping of external to internal ports including the -p switch. Example -p 80:8000
export PORT_MAP="${UI_PORT_MAP}${COMMS_UI_PORT_MAP}"
### Volume map [optional] - Mapping of external to internal paths including the -v switch. Example $(pwd):/wd
### What the host RUNS is mounted READ-ONLY: the checkout (/do-agent-aws - every host script sources its .env and
### .env.local), ~/.aws (a credential_process command in its config) and ~/.kube (an exec plugin in a kubeconfig). A
### container that could write them could run code as the operator on the host the next time a host script or an aws
### or kubectl call reads them. The container's writable data is /wd (the checkout's wd/) and its own state. To have the
### agent change the harness itself, it works in a clone under /wd/projects and the operator reviews and merges the
### branch on the host (docs/manual/install.md "Container user"). The two token caches the AWS CLI and the SDKs refresh in place,
### ~/.aws/sso/cache and ~/.aws/cli/cache, are mounted WRITABLE on top when the host has them - data the host reads and
### never runs - so an SSO session still refreshes from inside the container; kubectl's discovery cache under the
### read-only ~/.kube is not written (kubectl works without it). The agent's copy of ~/.aws for the memory API is made
### at container start (/agent/hindsight-aws-config.sh, run by ui-start.sh): with AWS_PROFILE set, boto3 looks the
### profile up under the process's HOME. The compose and kubernetes targets pass credentials through the environment.
### ~/.aws and ~/.kube are mounted only when they exist: a -v of a missing host directory makes Docker create it as
### root, and `aws` or `kubectl` inside the container then leave root-owned files in the user's home (an EC2 instance
### role or AWS_* variables need neither directory).
AWS_MOUNT=""; AWS_CACHE_MOUNTS=""
if [ -d "${HOME}/.aws" ]; then
  AWS_MOUNT="-v ${HOME}/.aws:/home/agent/.aws:ro"
  for C in sso/cache cli/cache; do
    [ -d "${HOME}/.aws/${C}" ] && AWS_CACHE_MOUNTS="${AWS_CACHE_MOUNTS} -v ${HOME}/.aws/${C}:/home/agent/.aws/${C}"
  done
fi
KUBE_MOUNT=""; [ -d "${HOME}/.kube" ] && KUBE_MOUNT="-v ${HOME}/.kube:/home/agent/.kube:ro"
### KUBE_HOST_MOUNT - computed, not set by hand: true when the host's ~/.kube is the container's /home/agent/.kube (KUBE_MOUNT).
### That kubeconfig is then the person's own, so the setup doctor (docs/manual/install.md "Setup doctor") gives `aws eks
### update-kubeconfig` as their host line, which also makes the new context the current one, and never runs it itself.
KUBE_HOST_MOUNT=false; [ -n "${KUBE_MOUNT}" ] && KUBE_HOST_MOUNT=true
export KUBE_HOST_MOUNT
export KUBE_ENV_OPTS="-e KUBE_HOST_MOUNT=$(shq "${KUBE_HOST_MOUNT}")"
export VOL_MAP="-v ${VOLUME_PATH_EXTERNAL}:${VOLUME_PATH_INTERNAL}:ro -v $(pwd)/wd:/wd${AWS_MOUNT:+ ${AWS_MOUNT}}${AWS_CACHE_MOUNTS}${KUBE_MOUNT:+ ${KUBE_MOUNT}} -v $(pwd):/do-agent-aws:ro"
### TEST_VOL_MAP - the mounts of the throwaway test container (test.sh): the checkout READ-ONLY (the tests read its
### .env and nothing else), the credentials as above without the writable token caches, and a THROWAWAY /wd (a tmpfs) in place of the user's wd/ - a
### test that writes under /wd writes nowhere that outlives the container. With the user's wd/ mounted, every
### ./test.sh grew the running harness's LogLearner index by the suite's own sessions (review of PR #31); test.sh
### now fails the suite when anything at all was written under /wd. The credentials and the kubeconfig are read-only
### too (kubectl writes a discovery cache under ~/.kube; nothing a test does may write the user's files).
export TEST_VOL_MAP="-v ${VOLUME_PATH_EXTERNAL}:${VOLUME_PATH_INTERNAL}:ro --tmpfs /wd:rw,size=256m${AWS_MOUNT:+ ${AWS_MOUNT}}${KUBE_MOUNT:+ ${KUBE_MOUNT}}"
### Network [optional] - Network name including the --net switch. Example --net mynet
export NETWORK=
### AGENT_SECRETS_ID [optional] - the AWS Secrets Manager secret (name or ARN) the container loads its third-party credentials
### from at every start: one JSON object of environment variable names to values (Slack, GitHub, IMAP, Telegram tokens, the
### Bedrock API key, ...). Empty: nothing is fetched, and a credential passed as an environment variable gets a WARNING line.
### aws/agent-secrets.yaml creates the secret (empty), its KMS key and a read-only policy for the role the container runs as.
### See docs/manual/aws.md "Credentials from AWS Secrets Manager". AGENT_SECRETS_REGION - its region (default AWS_REGION).
### AGENT_SECRETS_NAMES - the names taken from it (empty: the default list in /agent/secrets-load.sh, plus COMMS_ENV_NAMES).
export AGENT_SECRETS_ID=${AGENT_SECRETS_ID:-}
export AGENT_SECRETS_REGION=${AGENT_SECRETS_REGION:-}
export AGENT_SECRETS_NAMES=${AGENT_SECRETS_NAMES:-}
### AWS_ENV_OPTS [optional] - AWS credential/region passthrough for headless Bedrock access.
### Bare -e switches pass values from the host environment only when they are set there,
### and keep secret values out of the echoed docker command.
export AWS_ENV_OPTS="-e AWS_REGION -e AWS_DEFAULT_REGION -e AWS_PROFILE -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN -e AWS_BEARER_TOKEN_BEDROCK -e AGENT_SECRETS_ID -e AGENT_SECRETS_REGION -e AGENT_SECRETS_NAMES"
### Model settings - the Claude model every session in the container calls on Bedrock, its context window and its effort
### level (docs/manual/aws.md "Bedrock connectivity"). They reach the container as the environment Claude Code reads, so a person
### changes them in .env.local and restarts; nothing is pinned in the image or in the agent's settings.json (a model pinned
### there overrides every run, and the sandbox kit's build refuses an image that sets one - to/sandbox).
### AGENT_MODEL [optional] - the model id Claude Code calls, passed as ANTHROPIC_MODEL. Shipped as Claude Fable 5.1 through
### the us. cross-region inference profile, with the [1m] suffix: Claude Code's request for the 1M-token context window
### (code.claude.com/docs/en/amazon-bedrock "1M token context window", read 2026-10-31: for a pinned model id, "append [1m]
### to the model ID"). The suffix is not part of the Bedrock model id; the setup doctor (/agent/doctor.sh --check bedrock)
### shows the model, where it comes from and the context window, and probes Bedrock with the id without it. It needs model
### access to Claude Fable 5.1 in AWS_REGION (docs/bedrock/README.md "Enable model access", once per account and region).
### Without that access: another id the account can call, with the same suffix for the 1M window (Claude Opus 5.5:
### us.anthropic.claude-opus-5-5[1m]), or empty - then nothing is passed and Claude Code uses its own Bedrock default,
### which the doctor names (us.anthropic.claude-opus-5-5[1m] for the Claude Code in this image).
export AGENT_MODEL="us.anthropic.claude-fable-5-1[1m]"
### AGENT_EFFORT [optional] - the effort level of every session, passed as CLAUDE_CODE_EFFORT_LEVEL: low, medium, high,
### xhigh or max, each a deeper reasoning budget (code.claude.com/docs/en/model-config "Adjust effort level", read
### 2026-10-31: the variable outranks /effort and a saved level, and is the one way max applies beyond a single session;
### Fable 5.1 and Opus 5.5 offer all five). Shipped max. auto makes Claude Code send no effort level (the model's own
### default applies); empty passes nothing.
export AGENT_EFFORT="max"
### AGENT_MODEL_OPUS / AGENT_MODEL_FABLE [optional] - the ids the opus and fable aliases resolve to, passed as
### ANTHROPIC_DEFAULT_OPUS_MODEL and ANTHROPIC_DEFAULT_FABLE_MODEL (code.claude.com/docs/en/amazon-bedrock "Pin model
### versions"). An alias is what a sub-agent, a /model pick or an alias in AGENT_MODEL names; with AGENT_MODEL empty, Claude
### Code's default follows the opus one (measured 2026-10-31 on 2.1.304). Shipped as the 1M forms of Claude Opus 5.5 and Claude
### Fable 5.1, the values the native instance this harness is measured against runs with (the same model access applies);
### empty passes nothing, and Claude Code's own alias defaults apply (Opus 5.5 and Fable 5.1 on Bedrock).
export AGENT_MODEL_OPUS="us.anthropic.claude-opus-5-5[1m]"
export AGENT_MODEL_FABLE="us.anthropic.claude-fable-5-1[1m]"
### AGENT_MODEL_ENV_OPTS - passes the model settings to the container, each one only when it is set (no -e for an empty one,
### so Claude Code keeps its own default there). shq quotes the [1m] suffix, whose brackets are glob characters, for the
### eval in run.sh and test.sh, which read the id back as written; test-env-local.sh check 9 proves the bytes.
AGENT_MODEL_ENV_OPTS=""
if [ -n "${AGENT_MODEL}" ]; then AGENT_MODEL_ENV_OPTS="${AGENT_MODEL_ENV_OPTS} -e ANTHROPIC_MODEL=$(shq "${AGENT_MODEL}")"; fi
if [ -n "${AGENT_EFFORT}" ]; then AGENT_MODEL_ENV_OPTS="${AGENT_MODEL_ENV_OPTS} -e CLAUDE_CODE_EFFORT_LEVEL=$(shq "${AGENT_EFFORT}")"; fi
if [ -n "${AGENT_MODEL_OPUS}" ]; then AGENT_MODEL_ENV_OPTS="${AGENT_MODEL_ENV_OPTS} -e ANTHROPIC_DEFAULT_OPUS_MODEL=$(shq "${AGENT_MODEL_OPUS}")"; fi
if [ -n "${AGENT_MODEL_FABLE}" ]; then AGENT_MODEL_ENV_OPTS="${AGENT_MODEL_ENV_OPTS} -e ANTHROPIC_DEFAULT_FABLE_MODEL=$(shq "${AGENT_MODEL_FABLE}")"; fi
export AGENT_MODEL_ENV_OPTS="${AGENT_MODEL_ENV_OPTS# }"
### AGENT_STATE_PATH_EXTERNAL [optional] - host folder where mutable agent state is persisted so it survives
### container restarts and replacement: Claude Code configuration and plugins (/home/agent/.claude), claude-mem memory
### (/home/agent/.claude-mem), the hindsight coding-agent hooks' configuration (/home/agent/.hindsight), and the Hindsight
### memory DATABASE - the embedded PostgreSQL the Hindsight API keeps every memory, bank and seed in, owned by the
### unprivileged hindsight user at /home/hindsight/.pg0 (persisted under hindsight-pg0/) - without it a recreated
### container came back with an empty memory - and vibe-kanban's state (/home/agent/.local/share/vibe-kanban: its config,
### workspace database and signing key; without it every restart lost the workspaces and replayed the first-visit
### tour). Set empty to run with ephemeral agent state.
export AGENT_STATE_PATH_EXTERNAL=${VOLUME_PATH_EXTERNAL}/wd/agent-state
### AGENT_STATE_VOL_MAP [optional] - mounts persisting the agent state directories on AGENT_STATE_PATH_EXTERNAL.
### Bind-backed volumes are used instead of plain -v bind mounts so that on first run Docker seeds the image's
### baked content (installed plugins, settings, the initialised memory database) into the empty host folders
### instead of shadowing it, keeping the image's ownership (the database must stay the hindsight user's).
### Each entry is <host subfolder of AGENT_STATE_PATH_EXTERNAL>:<path inside the container>. The container's own
### kubeconfig (the agent's `aws eks update-kubeconfig`, docs/manual/install.md "Setup doctor") is kept here too, under .kube, unless
### the host's ~/.kube is mounted at /home/agent/.kube instead (KUBE_MOUNT above): one mount per path, and the host's wins.
export AGENT_STATE_VOL_MAP=""
if [ -n "${AGENT_STATE_PATH_EXTERNAL}" ]; then
  AGENT_STATE_DIRS=".claude:/home/agent/.claude .claude-mem:/home/agent/.claude-mem .hindsight:/home/agent/.hindsight hindsight-pg0:/home/hindsight/.pg0 vibe-kanban:/home/agent/.local/share/vibe-kanban"
  [ -z "${KUBE_MOUNT}" ] && AGENT_STATE_DIRS="${AGENT_STATE_DIRS} .kube:/home/agent/.kube"
  for m in ${AGENT_STATE_DIRS}; do
    d=${m%%:*}
    mkdir -p "${AGENT_STATE_PATH_EXTERNAL}/${d}"
    AGENT_STATE_VOL_MAP="${AGENT_STATE_VOL_MAP} --mount type=volume,volume-driver=local,volume-opt=type=none,volume-opt=o=bind,volume-opt=device=${AGENT_STATE_PATH_EXTERNAL}/${d},dst=${m#*:}"
  done
  # the compose template mounts no host ~/.kube and binds .kube always, and a bind volume needs its folder
  mkdir -p "${AGENT_STATE_PATH_EXTERNAL}/.kube"
  export AGENT_STATE_VOL_MAP
fi
### AUTONOMY_LOOP [optional] - start the autonomy loop (/agent/loop-start.sh) at container startup, AUTONOMY_LOOP=auto|false|true
### auto = on when SLACK_BOT_TOKEN and SLACK_CHANNELS below are set (a Slack-connected agent needs the loop to work on the
### goals stated in chat) and off otherwise; false turns it off; true forces it on (a loop with no Slack). Decided in /agent/slack-gates.sh.
### The loop periodically fires a headless claude cycle against the goals file below; see docs/manual/autonomy.md "Autonomy loop"
export AUTONOMY_LOOP=auto
### AUTONOMY_LOOP_INTERVAL - seconds to sleep between loop fires
export AUTONOMY_LOOP_INTERVAL=300
### AUTONOMY_LOOP_GOALS - goals file the loop works toward; keep it on the /wd volume so it persists
### With SLACK_WATCH_ENABLED=true the file is optional: until it exists the loop fires on new Slack messages against /agent/goals-default.md (docs/manual/autonomy.md "Autonomy loop")
export AUTONOMY_LOOP_GOALS=/wd/goals/GOALS.md
### AUTONOMY_LOOP_FIRE_TIMEOUT - per-fire timeout in seconds for the headless claude call; 1500 is the bound a native
### Claude Code instance's loop gives one fire (docs/manual/autonomy.md "Autonomy loop", docs/parity/PARITY-GAP.md); 600 was the default
### until 2026-10-31
export AUTONOMY_LOOP_FIRE_TIMEOUT=1500
### AUTONOMY_LOOP_CLAUDE_OPTS [optional] - the claude options of every fire; unset (the shipped state), /agent/loop.sh
### uses its default, the safe value: the fire reads and edits files under acceptEdits and runs only /agent/slack-post.sh,
### /agent/slack-upload.sh, /agent/recall.sh and /agent/bus-answer.sh (--allowedTools Bash(/agent/slack-post.sh:*) Bash(/agent/slack-upload.sh:*) Bash(/agent/recall.sh:*) Bash(/agent/bus-answer.sh:*) --permission-mode acceptEdits).
### The opt-in, for a host whose goals and Slack channels are trusted with it: the fire runs every tool without a
### permission check, as a native instance's loop does, and gets IS_SANDBOX=1 so Claude Code accepts the flag:
###   export AUTONOMY_LOOP_CLAUDE_OPTS="--dangerously-skip-permissions"
### Set it with export in .env.local (docs/manual/autonomy.md "Autonomy loop": the rule order, rules with spaces, the risk). Passed bare
### below: docker copies the value from the environment, whole, and passes nothing when it is unset. A rule may hold
### spaces inside its parentheses - Bash(bash /wd/loop/run-next-fire/apply_to_source.sh:*), Bash(kubectl get:*) - since
### 2026-11-03: the value is split on blanks outside parentheses only (/agent/claude-opts.sh)
### AUTONOMY_LOOP_OPTS_CHECK [optional] - before its fires the loop checks that value, and the chat responder
### SLACK_CHAT_CLAUDE_OPTS: a word of an allow or deny list that cannot be a rule (parentheses that do not pair up, quotes,
### a tool name that can match no tool) is reported with the word quoted - the loop's in /wd/loop/loop.log, the
### responder's in /wd/slack/chat.log - and each fire is skipped instead of run - no claude call, END rc=96
### outcome=config <report>, the report as the fire's transcript -
### because claude would ignore that rule, deny every call it allows and let the fire run on until
### AUTONOMY_LOOP_FIRE_TIMEOUT (the responder answers such a message with one line saying so). Unset (the shipped state)
### it is on; false logs the report as a WARNING and runs the calls anyway. Passed bare below
### LOOP_INBOX [optional] - every fire reads agent's open bus requests and notices before its goals (docs/manual/autonomy.md "Autonomy
### loop", "A fire reads its inbox first"); unset (the shipped state) it is on, false turns it off. Passed bare below too
### LOOP_INBOX_MAX [optional] - the most of those messages one fire is handed: unset (the shipped state) 8, at most
### 50; the rest wait for the next fire. Passed bare below as well
### GOAL_WATCH [optional] - the always-running goal watcher (/agent/goal-watch.sh, started by startup.sh): while the
### loop is stopped (/wd/loop/STOP present, or no loop holding its lock) it starts it with /agent/loop-start.sh when a
### new unchecked goal appears in AUTONOMY_LOOP_GOALS (added via chat, board.sh or an edit). Unset (the shipped state)
### it is on; false turns it off. Log /wd/loop/goal-watch.log. Passed bare below
### GOAL_WATCH_INTERVAL [optional] - seconds between its checks; unset (the shipped state) 120. Passed bare below too
### AUTONOMY_LOOP_MODE - how the loop works its goals: serial (the shipped state - one fire at a time on the first open
### goal in file order, the cycle as it always was) or supervisor (G99 - every cycle plans the open goals with
### /agent/supervisor-plan.py: a goal with a leading "(priority: high)" note first, then file order; goals that share a
### checkout, a file, an AWS account, a Slack thread or a pending answer form one serial chain, independent goals run at
### the same time, one worker fire per group, up to SUPERVISOR_MAX_WORKERS; docs/manual/autonomy.md "Autonomy loop", "Supervisor mode").
### Not the spoke supervisor (SUPERVISOR below), which starts and watches the spoke sessions and never calls a model
export AUTONOMY_LOOP_MODE=serial
### AUTONOMY_LOOP_DRY_RUN - true: the loop runs ONE cycle that prints what it would fire (serial: WOULD FIRE <n>
### mode=serial; supervisor: one WOULD FIRE line per worker, the planner's dispatch) with no claude call, no Slack or bus
### read, no board call and no STOP or WAKE change, then exits (state STOPPED reason=dry-run) - the preview of a plan over
### the live goals file. Set it back to false afterwards: the goal watcher starts the loop again on the next new goal
export AUTONOMY_LOOP_DRY_RUN=false
### SUPERVISOR_MAX_WORKERS - worker fires a supervisor cycle runs at once; 1 = one fire at a time, in priority order
export SUPERVISOR_MAX_WORKERS=3
### SUPERVISOR_MODEL_PASS - true: a short model pass over the plan that may only merge groups (DESIGN.md section 5
### step 3). Declared and reserved: this version logs that the pass is not implemented and the deterministic plan stands
export SUPERVISOR_MODEL_PASS=false
### SUPERVISOR_MODEL_TIMEOUT - seconds that pass may take when it exists
export SUPERVISOR_MODEL_TIMEOUT=120
### SUPERVISOR_STRIKES_MAX - a goal whose worker ended rc != 0 this many fires in a row (a timeout 124/137, a config 96
### or a credentials 97 end excepted, as the bus intake counts) is parked
export SUPERVISOR_STRIKES_MAX=3
### SUPERVISOR_PARK_CYCLES - cycles a parked goal sits out before it is planned again; /agent/goals-add.sh --unpark G<n>
### ends the parking sooner, and a worker that ends well clears the goal's strikes
export SUPERVISOR_PARK_CYCLES=6
### SUPERVISOR_WORKER_OPTS [optional] - extra claude options for a worker, after AUTONOMY_LOOP_CLAUDE_OPTS (for example
### --max-turns 60); empty (the shipped state) adds none. Set it in .env.local. Passed bare below like
### AUTONOMY_LOOP_CLAUDE_OPTS, so a rule with spaces inside its parentheses reaches the container whole
export SUPERVISOR_WORKER_OPTS=
### AUTONOMY_ENV_OPTS - passes the autonomy loop settings to the container, the supervisor mode's included
export AUTONOMY_ENV_OPTS="-e AUTONOMY_LOOP=$(shq "${AUTONOMY_LOOP}") -e AUTONOMY_LOOP_INTERVAL=$(shq "${AUTONOMY_LOOP_INTERVAL}") -e AUTONOMY_LOOP_GOALS=$(shq "${AUTONOMY_LOOP_GOALS}") -e AUTONOMY_LOOP_FIRE_TIMEOUT=$(shq "${AUTONOMY_LOOP_FIRE_TIMEOUT}") -e AUTONOMY_LOOP_CLAUDE_OPTS -e AUTONOMY_LOOP_OPTS_CHECK -e LOOP_INBOX -e LOOP_INBOX_MAX -e GOAL_WATCH -e GOAL_WATCH_INTERVAL -e AUTONOMY_LOOP_MODE=$(shq "${AUTONOMY_LOOP_MODE}") -e AUTONOMY_LOOP_DRY_RUN=$(shq "${AUTONOMY_LOOP_DRY_RUN}") -e SUPERVISOR_MAX_WORKERS=$(shq "${SUPERVISOR_MAX_WORKERS}") -e SUPERVISOR_MODEL_PASS=$(shq "${SUPERVISOR_MODEL_PASS}") -e SUPERVISOR_MODEL_TIMEOUT=$(shq "${SUPERVISOR_MODEL_TIMEOUT}") -e SUPERVISOR_STRIKES_MAX=$(shq "${SUPERVISOR_STRIKES_MAX}") -e SUPERVISOR_PARK_CYCLES=$(shq "${SUPERVISOR_PARK_CYCLES}") -e SUPERVISOR_WORKER_OPTS"
### Shared agent tmux session settings (see docs/manual/ui.md "tmux in the browser") - the one
### session BOTH doors land in: the browser /tmux/ terminal and a docker exec / ./exec.sh
### shell, with the interactive claude CLI already running in it.
### AGENT_TMUX_SESSION - create the session at container start, AGENT_TMUX_SESSION=true|false.
### When false the feature is off end to end: no session is created, exec shells stay plain,
### and the container behaves exactly as before (the browser /tmux/ terminal still
### lazily creates a session on first connect, the pre-feature behavior).
export AGENT_TMUX_SESSION=true
### AGENT_TMUX_SESSION_NAME - name of the shared session; ttyd, the exec-shell auto-attach,
### and tmux-session-start.sh all follow this name, so changing it keeps the doors aligned
export AGENT_TMUX_SESSION_NAME=agent
### AGENT_TMUX_CLAUDE - start the interactive claude CLI in the session's pane,
### AGENT_TMUX_CLAUDE=true|false. When claude exits (or with false) the pane falls back to
### a shell - the session always survives (see /agent/tmux-claude.sh).
export AGENT_TMUX_CLAUDE=true
### AGENT_TMUX_CLAUDE_OPTS - extra options for that claude call (e.g. --continue, or several:
### "--continue --verbose"), split into words by /agent/tmux-claude.sh; quote characters reach
### claude literally (as a prompt, not a flag). run.sh and test.sh pass the whole value (quoted
### for the shell, shq above), as the compose and kubernetes templates do.
export AGENT_TMUX_CLAUDE_OPTS=""
### TMUX_AUTO_ATTACH - interactive exec shells attach to the shared session,
### TMUX_AUTO_ATTACH=true|false. The per-shell escape hatch:
### `docker exec -e TMUX_AUTO_ATTACH=false -it do-agent-aws bash` gets a plain shell.
### Only interactive shells with a terminal ever attach - scripted
### `docker exec <container> <command>` calls are untouched either way.
export TMUX_AUTO_ATTACH=true
### AGENT_TMUX_ENV_OPTS - passes the agent tmux session settings to the container
export AGENT_TMUX_ENV_OPTS="-e AGENT_TMUX_SESSION=$(shq "${AGENT_TMUX_SESSION}") -e AGENT_TMUX_SESSION_NAME=$(shq "${AGENT_TMUX_SESSION_NAME}") -e AGENT_TMUX_CLAUDE=$(shq "${AGENT_TMUX_CLAUDE}") -e AGENT_TMUX_CLAUDE_OPTS=$(shq "${AGENT_TMUX_CLAUDE_OPTS}") -e TMUX_AUTO_ATTACH=$(shq "${TMUX_AUTO_ATTACH}")"
### Spoke agents [optional] - resident Claude Code sessions beside the agent session, one per dashboard whose data it keeps
### current (docs/manual/agents.md "Spoke agents", docs/AGENT-STACK.md). The registry /agent/spokes/registry.json lists them; each
### runs in its own tmux session, in /wd/<name>, with its charter (/agent/charters/<name>/charter.md) as its CLAUDE.md,
### started and kept alive by the supervisor; the home page has a tile per spoke and the tmux-agent dashboard shows it
### under agent. SPOKE_<NAME>=true|false switches one. The seven spokes below ship on and the example off, so a fresh
### ./run.sh starts seven resident Claude Code sessions beside agent (tmux ls: agent, clusters, conversations, docker,
### insights, issues, loops, sessions, supervisor). A spoke's session spends Bedrock tokens when someone talks to it; the
### conversations loop reads Slack every cycle once SLACK_BOT_TOKEN and SLACK_CHANNELS are set, and waits for Slack until
### then; the issues loop reads GitHub every 15 minutes once GH_TOKEN is set, and waits for GitHub until then. To turn
### one off, set SPOKE_<NAME>=false in .env.local, then ./stop.sh && ./run.sh.
### SPOKE_CONVERSATIONS - the conversations spoke: polls, classifies and journals the configured channels and stages
### replies, never sends (the Conversations tile); Slack read calls every cycle with SLACK_BOT_TOKEN and SLACK_CHANNELS
### set; without them it waits for Slack (its session runs, its cycle does not)
export SPOKE_CONVERSATIONS=true
### SPOKE_INSIGHTS - the insights spoke: mines new session transcripts into rule candidates through the gates (the Session
### insights tile); no model calls in its hourly cycle
export SPOKE_INSIGHTS=true
### SPOKE_CLUSTERS - the clusters spoke: read-only status of every configured Kubernetes context (the Headlamp tile); with
### no kubeconfig it reports no context
export SPOKE_CLUSTERS=true
### SPOKE_SESSIONS - the sessions spoke: keeps the books of the container's tmux sessions from the dashboard's census (the
### tmux-agent dashboard tile); its cycle is not written yet
export SPOKE_SESSIONS=true
### SPOKE_LOOPS - the loops spoke: keeps the Loop Deck's topology and loop health true each cycle (the Loop Deck tile)
export SPOKE_LOOPS=true
### SPOKE_ISSUES - the issues spoke: triages the open issues and pull requests in scope (conflicts, failing checks,
### requested changes, what needs a reply) and stages reply drafts; nothing posts without a person's GO through
### /agent/charters/issues/post.sh (the Board tile); read-only GitHub calls every 15 minutes with GH_TOKEN set
### (GITHUB_ENV_OPTS below); without it it waits for GitHub (its session runs, its cycle does not)
export SPOKE_ISSUES=true
### SPOKE_DOCKER - the docker spoke: builds container images inside the harness through the stack's own build substrate
### and keeps its page current - the daemon, the registry, the images in it, the build cache and the disk headroom
### (docs/manual/agents.md "Docker agent"); local reads every 5 minutes. On the docker target it also turns the substrate on: two
### more sidecar containers, a rootless BuildKit daemon and a registry (the Docker build substrate settings below).
### false: no docker session, and ./run.sh starts neither sidecar
export SPOKE_DOCKER=true
### SPOKE_EXAMPLE - the example spoke: a timestamp every cycle and an answer to every question, from a shell loop that
### spends no model tokens - the way to see the scaffold work end to end
export SPOKE_EXAMPLE=false
### SUPERVISOR - the supervisor, a script that never calls a model, started with the container: it starts every enabled
### session of the registry and keeps them and the agent session alive and unstuck - it restarts a spoke that died,
### reports a session at a menu, an API error or a long context, sends /compact once into an idle spoke at 80% context,
### starts the Loop Deck's server again when it died, and never answers a menu (docs/manual/agents.md "Spoke agents"). false: nothing
### starts or watches the spokes or the Deck's server
export SUPERVISOR=true
### SUPERVISOR_INTERVAL - seconds between two passes of the supervisor (a killed spoke is back within one)
export SUPERVISOR_INTERVAL=15
### SUPERVISOR_RESTART_CAP / SUPERVISOR_HEALTHY_SECS - a spoke that exits is started again at once, then after its
### cooldown, doubling; after SUPERVISOR_RESTART_CAP restarts without staying up SUPERVISOR_HEALTHY_SECS its tile reads
### stuck and the supervisor leaves it alone until it starts again
export SUPERVISOR_RESTART_CAP=5
export SUPERVISOR_HEALTHY_SECS=300
### SUPERVISOR_START_GRACE - seconds a session's pane may run without its agent process (claude) after its start
export SUPERVISOR_START_GRACE=120
### SUPERVISOR_MEMORY_QUEUE_WARN - the session-memory worker's queue depth the supervisor reports
export SUPERVISOR_MEMORY_QUEUE_WARN=500
### SUPERVISOR_CLOSE_EXITED - the supervisor closes a scratch tmux session (one the registry does not list) whose every
### pane's process has exited, at two passes in a row: it copies the output tmux kept for those panes to
### /wd/supervisor/closed/<session>.<created>.txt first (a session whose output cannot be copied stays open), then records
### the close and the file in the session ledger (/wd/supervisor/sessions-ledger.jsonl; /agent/supervisor.sh resume
### <session> recreates it); a pane whose process runs is never touched, nor is a session of the registry. false: the
### supervisor closes nothing
export SUPERVISOR_CLOSE_EXITED=true
### SPOKE_ENV_OPTS - passes the spoke and supervisor settings to the container: bare -e switches, each value exported above
export SPOKE_ENV_OPTS="-e SPOKE_CONVERSATIONS -e SPOKE_INSIGHTS -e SPOKE_CLUSTERS -e SPOKE_SESSIONS -e SPOKE_LOOPS -e SPOKE_ISSUES -e SPOKE_DOCKER -e SPOKE_EXAMPLE -e SUPERVISOR -e SUPERVISOR_INTERVAL -e SUPERVISOR_RESTART_CAP -e SUPERVISOR_HEALTHY_SECS -e SUPERVISOR_START_GRACE -e SUPERVISOR_MEMORY_QUEUE_WARN -e SUPERVISOR_CLOSE_EXITED"
### Slack connectivity [optional] - agent access to Slack channels via YOUR OWN Slack app
### (see docs/manual/channels.md "Slack connectivity" and docs/slack/README.md for creating the app, scopes,
### inviting the bot, and finding channel IDs). A bot token and a channel list are enough: with
### SLACK_BOT_TOKEN and SLACK_CHANNELS set, the gates below at their auto default turn on the chat
### responder (answers messages as they arrive), the watch and replying (and AUTONOMY_LOOP=auto above
### starts the loop that works on the goals); with nothing set no Slack code runs and the container
### behaves exactly as before.
### SLACK_BOT_TOKEN - Bot User OAuth Token (xoxb-...) of the user's own Slack app. Set it here or
### export it in the host environment before ./run.sh (the ${SLACK_BOT_TOKEN:-} form keeps a
### host-exported value). NEVER commit a real token to the repository.
export SLACK_BOT_TOKEN="${SLACK_BOT_TOKEN:-}"
### SLACK_CHANNELS - comma-separated Slack channel IDs (e.g. C0123ABCDEF,C0456GHIJKL - no spaces)
### the agent watches; posting is allowed only to these channels
export SLACK_CHANNELS=""
### SLACK_ALLOWED_USERS - comma-separated Slack user IDs (e.g. U0123ABCDEF,U0456GHIJKL - no spaces; a person's ID is in
### their Slack profile, "Copy member ID") whose messages reach the agent, or the one word anyone for every person in the
### channels. EMPTY (the default) takes no one's message, with a WARNING in the watch log: the agent acts on what its
### inbox says, so the people who may drive it are named. Other bots' messages never reach it (/agent/slack-watch.sh)
export SLACK_ALLOWED_USERS=""
### SLACK_TEST_CHANNEL - a channel id of your own for the Slack doctor's round-trip (/agent/slack-doctor.sh --post-test
### posts two labelled messages there and reads them back; docs/manual/install.md "Setup doctor"). Unused otherwise; may equal one of
### SLACK_CHANNELS.
export SLACK_TEST_CHANNEL=""
### SLACK_WATCH_ENABLED - poll the channels at the start of every autonomy-loop cycle and hand new
### messages to the agent as context, SLACK_WATCH_ENABLED=auto|false|true
### auto = on when SLACK_BOT_TOKEN and SLACK_CHANNELS are set, false turns it off, true forces it on.
### Governs the loop only while SLACK_CHAT_ENABLED below is off: with the chat responder on it owns the
### inbox and the loop runs no watch of its own
export SLACK_WATCH_ENABLED=auto
### SLACK_POST_ENABLED - allow /agent/slack-post.sh to post to the channels above,
### SLACK_POST_ENABLED=auto|false|true. auto = on when SLACK_BOT_TOKEN and SLACK_CHANNELS are set,
### false turns it off, true forces it on. A separate gate: the explicit false is the opt-out for an
### agent that may read but must not speak (e.g. the read-only user-token path in docs/slack/README.md).
export SLACK_POST_ENABLED=auto
### SLACK_REPLY_IN_THREAD - where the agent's answer to a TOP-LEVEL message goes, SLACK_REPLY_IN_THREAD=true|false.
### true (the default): in a thread under that message, and everything later on that topic - the chat responder's
### answers, and the replies of a loop that takes Slack in itself (SLACK_CHAT_ENABLED=false) - goes to the same
### thread, so the channel's top level stays the list of topics. false: the behaviour until 2026-10-31 - a top-level message is
### answered top-level, where the person wrote. A message written in a thread is answered in that thread either way,
### and so is a top-level message that already has a thread when the agent first sees it. Only the value false turns it
### off; any other value is read as true (the chat responder logs a WARNING for a value that is neither).
### Read by /agent/slack-chat.sh, loop.sh and loop-once.sh at their start (docs/manual/channels.md "Slack connectivity",
### docs/slack/README.md section 6a); a change takes effect at the next ./stop.sh && ./run.sh
export SLACK_REPLY_IN_THREAD=true
### SLACK_CHAT_ENABLED - run the Slack chat responder (/agent/slack-chat.sh): an always-on process that
### answers messages in the channels above as they arrive, independent of the autonomy loop and its
### interval ("status", "goals" and "help" from the state files with no model call; anything else through
### one headless claude call; a goal stated in chat is added to the goals file for the loop),
### SLACK_CHAT_ENABLED=auto|false|true. auto = on when SLACK_BOT_TOKEN and SLACK_CHANNELS are set, false
### turns it off (the loop's own per-cycle watch is then the intake), true forces it on
export SLACK_CHAT_ENABLED=auto
### SLACK_CHAT_POLL_INTERVAL - seconds between the responder's polls of the channels; a reply takes one
### poll interval, plus one model call for a free-form question (none for status/goals/help)
export SLACK_CHAT_POLL_INTERVAL=5
### SLACK_CHAT_TIMEOUT - per-reply timeout in seconds for the responder's headless claude call; 1500 is the bound a native
### instance gives one answer (docs/manual/autonomy.md "Autonomy loop", docs/parity/PARITY-GAP.md); 180 until 2026-10-31
export SLACK_CHAT_TIMEOUT=1500
### SLACK_CHAT_CLAUDE_OPTS - claude options for a reply. The default lives in /agent/slack-chat.sh, the safe value:
###   --allowedTools Bash(/agent/slack-post.sh:*) Bash(/agent/slack-upload.sh:*) Bash(/agent/goals-add.sh:*) --permission-mode acceptEdits
### (the allow rules FIRST, the prompt on stdin): a reply reads and edits files, posts, attaches a file and records a
### goal, and headless claude denies every other Bash call. Not set by value here: passed bare, so the default stays
### slack-chat.sh's until you override it in .env.local (or export it in the host shell before ./run.sh) - the bare -e
### below passes it, whole, only when set; an override that uses acceptEdits must keep the rules if the agent is to
### reply and record goals. The opt-in --dangerously-skip-permissions (with IS_SANDBOX=1, as the loop's fire) lets every
### person SLACK_ALLOWED_USERS names have the responder run any command in the container (docs/manual/channels.md "Slack connectivity")
### SLACK_ENV_OPTS - passes the Slack settings to the container. The bare -e SLACK_BOT_TOKEN
### passes the token from the environment without echoing its value in the docker command
### (same pattern as AWS_ENV_OPTS - no secret values in this file or on the command line).
export SLACK_ENV_OPTS="-e SLACK_BOT_TOKEN -e SLACK_CHANNELS=$(shq "${SLACK_CHANNELS}") -e SLACK_ALLOWED_USERS=$(shq "${SLACK_ALLOWED_USERS}") -e SLACK_TEST_CHANNEL=$(shq "${SLACK_TEST_CHANNEL}") -e SLACK_WATCH_ENABLED=$(shq "${SLACK_WATCH_ENABLED}") -e SLACK_POST_ENABLED=$(shq "${SLACK_POST_ENABLED}") -e SLACK_REPLY_IN_THREAD=$(shq "${SLACK_REPLY_IN_THREAD}") -e SLACK_CHAT_ENABLED=$(shq "${SLACK_CHAT_ENABLED}") -e SLACK_CHAT_POLL_INTERVAL=$(shq "${SLACK_CHAT_POLL_INTERVAL}") -e SLACK_CHAT_TIMEOUT=$(shq "${SLACK_CHAT_TIMEOUT}") -e SLACK_CHAT_CLAUDE_OPTS"
### UI_ENV_OPTS - passes the harness UI settings to the container. The bare -e HINDSIGHT_API_LLM_*
### switches pass provider overrides from the host environment only when set there (inside the
### container hindsight defaults to the bedrock provider), and the bare -e TMUX_AGENT_SRC passes
### an optional dashboard source the same way (it may carry a token); no secret values in this file.
### LOOP_DECK_URL - the Loop Deck of a fleet this harness is part of (the loop observability console: fire timelines,
### breakers, history, runbook), for the operator who runs it. The harness serves a Deck of its own (UI_LOOP_DECK above:
### the Loop Deck tile, at loop-deck.localhost, over this harness's own loops); with LOOP_DECK_URL set, the home page shows
### a "Fleet Loop Deck" tile linking that URL in the served tile's place (the served route stays). Empty (the default): no
### Fleet Loop Deck tile, and the served Loop Deck tile stays live. The URL as YOUR BROWSER reaches it, since the link
### opens from the browser, not from the container: with the deck on its host's loopback port behind an SSH tunnel,
### http://localhost:8091/. Only a plain http(s)://host[:port][/path] URL is accepted - the shape the home page links,
### checked below on the whole value; any other value (another scheme, a second line, shell or HTML syntax) is refused
### when this file is read, with the WARNING "LOOP_DECK_URL is not a plain http(s)://host[:port][/path] URL; no Fleet
### Loop Deck tile (the served Loop Deck tile stays)", and passed empty. Not served, proxied or probed by this harness.
export LOOP_DECK_URL=""
# the check, on the whole value with the home page's pattern (home-render.sh): a refused value is emptied by assignment,
# because on this file's second pass an export of a name .env.local sets keeps the .env.local value
LOOP_DECK_URL_SHAPE='^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~!$&()*+,;=:@/%#?-]*)?$'
if [ -n "${LOOP_DECK_URL}" ] && ! [[ "${LOOP_DECK_URL}" =~ ${LOOP_DECK_URL_SHAPE} ]]; then
  echo "WARNING: LOOP_DECK_URL is not a plain http(s)://host[:port][/path] URL; no Fleet Loop Deck tile (the served Loop Deck tile stays) - it is passed empty" >&2
  LOOP_DECK_URL=""
fi
unset LOOP_DECK_URL_SHAPE

export UI_ENV_OPTS="-e UI_START=$(shq "${UI_START}") -e PORT_EXTERNAL_HOME=$(shq "${PORT_EXTERNAL_HOME}") -e UI_HEADLAMP=$(shq "${UI_HEADLAMP}") -e UI_HINDSIGHT=$(shq "${UI_HINDSIGHT}") -e HINDSIGHT_SEED=$(shq "${HINDSIGHT_SEED}") -e UI_VIBE_KANBAN=$(shq "${UI_VIBE_KANBAN}") -e UI_PLANE=$(shq "${UI_PLANE}") -e UI_CLAUDE_MEM=$(shq "${UI_CLAUDE_MEM}") -e UI_LOGLEARNER=$(shq "${UI_LOGLEARNER}") -e UI_BOARD=$(shq "${UI_BOARD}") -e UI_FILES=$(shq "${UI_FILES}") -e UI_CHAT=$(shq "${UI_CHAT}") -e UI_LOOP=$(shq "${UI_LOOP}") -e UI_LOOP_CONTROL=$(shq "${UI_LOOP_CONTROL}") -e UI_HOME=$(shq "${UI_HOME}") -e UI_HOME_HOSTNAMES=$(shq "${UI_HOME_HOSTNAMES}") -e UI_HOME_ALLOW_FROM=$(shq "${UI_HOME_ALLOW_FROM}") -e UI_PUBLISH_DIRECT_PORTS=$(shq "${UI_PUBLISH_DIRECT_PORTS}") -e UI_TMUX=$(shq "${UI_TMUX}") -e UI_TMUX_WRITABLE=$(shq "${UI_TMUX_WRITABLE}") -e UI_TMUX_AGENT=$(shq "${UI_TMUX_AGENT}") -e UI_PORT_HEADLAMP=$(shq "${PORT_INTERNAL_HEADLAMP}") -e UI_PORT_HINDSIGHT_API=$(shq "${PORT_INTERNAL_HINDSIGHT_API}") -e UI_PORT_HINDSIGHT_UI=$(shq "${PORT_INTERNAL_HINDSIGHT_UI}") -e UI_PORT_VIBE_KANBAN=$(shq "${PORT_INTERNAL_VIBE_KANBAN}") -e UI_PORT_CLAUDE_MEM=$(shq "${PORT_INTERNAL_CLAUDE_MEM}") -e UI_PORT_LOGLEARNER=$(shq "${PORT_INTERNAL_LOGLEARNER}") -e UI_PORT_BOARD=$(shq "${PORT_INTERNAL_BOARD}") -e UI_PORT_FILES=$(shq "${PORT_INTERNAL_FILES}") -e FILES_DIR=$(shq "${FILES_DIR}") -e FILES_MAX_UPLOAD_MB=$(shq "${FILES_MAX_UPLOAD_MB}") -e UI_PORT_CHAT=$(shq "${PORT_INTERNAL_CHAT}") -e UI_PORT_LOOP=$(shq "${PORT_INTERNAL_LOOP}") -e UI_PORT_HOME=$(shq "${PORT_INTERNAL_HOME}") -e UI_PORT_TMUX=$(shq "${PORT_INTERNAL_TMUX}") -e UI_PORT_TMUX_AGENT=$(shq "${PORT_INTERNAL_TMUX_AGENT}") -e TMUX_AGENT_SRC -e TMUX_AGENT_REF=$(shq "${TMUX_AGENT_REF}") -e TMUX_AGENT_INSTALL_DIR=$(shq "${TMUX_AGENT_INSTALL_DIR}") -e HINDSIGHT_API_LLM_PROVIDER -e HINDSIGHT_API_LLM_API_KEY -e HINDSIGHT_API_LLM_MODEL -e HINDSIGHT_API_LLM_OUTPUT_LANGUAGE -e LOOP_DECK_URL=$(shq "${LOOP_DECK_URL}") -e UI_LOOP_DECK=$(shq "${UI_LOOP_DECK}")"
export UI_ENV_OPTS="${UI_ENV_OPTS} -e CLAUDE_MEM_VIEWER_WRAPPER=$(shq "${CLAUDE_MEM_VIEWER_WRAPPER}")"
### COMMS_ENV_OPTS - passes the comms UI settings to the container (see docs/manual/channels.md "Comms UI");
### no token values here - the engine reads credentials only from env: references in
### settings.json (docs/comms/README.md), and the variables those references name reach the
### container as the bare `-e NAME` switches rendered from COMMS_ENV_NAMES above
export COMMS_ENV_OPTS="-e COMMS_UI_ENABLED=$(shq "${COMMS_UI_ENABLED}") -e COMMS_UI_PORT=$(shq "${PORT_INTERNAL_COMMS_UI}") -e COMMS_DEMO_SEED=$(shq "${COMMS_DEMO_SEED}") -e COMMS_UI_WRITE_ENABLED=$(shq "${COMMS_UI_WRITE_ENABLED}") -e COMMS_UI_BASE_PATH=$(shq "${COMMS_UI_BASE_PATH}") -e COMMS_WATCH_ENABLED=$(shq "${COMMS_WATCH_ENABLED}") ${COMMS_ENV_NAME_OPTS}"
### AGENT_LEARNING_ENV_OPTS - passes the agent learning settings to the container (docs/manual/memory.md "Agent learning tools")
export AGENT_LEARNING_ENV_OPTS="-e LOGLEARNER_HOOK=$(shq "${LOGLEARNER_HOOK}") -e AGENT_KNOWLEDGE=$(shq "${AGENT_KNOWLEDGE}") -e AGENT_MEMORY=$(shq "${AGENT_MEMORY}") -e AGENT_OVERLAY=$(shq "${AGENT_OVERLAY}") -e AGENT_SKILLS_PACK=$(shq "${AGENT_SKILLS_PACK}") -e LOGLEARNER_S3_BUCKET=$(shq "${LOGLEARNER_S3_BUCKET}") -e LOGLEARNER_S3_PREFIX=$(shq "${LOGLEARNER_S3_PREFIX}") -e LOGLEARNER_PACK=$(shq "${LOGLEARNER_PACK}") -e LOGLEARNER_PACK_VERSION=$(shq "${LOGLEARNER_PACK_VERSION}")"
### GITHUB_ENV_OPTS - a GitHub token for the agent [optional]: GH_TOKEN or GITHUB_TOKEN (gh and git read them;
### startup.sh also hands the value to the GitHub plugin as GITHUB_PERSONAL_ACCESS_TOKEN, the variable its MCP server
### reads). The plugin is enabled only while one is set - without a token its MCP server failed to connect in every
### session. Bare -e switches: the value comes from the host environment when exported there and never appears in this
### file or in the echoed docker command (the SLACK_BOT_TOKEN pattern). Never commit a real token.
export GITHUB_ENV_OPTS="-e GH_TOKEN -e GITHUB_TOKEN -e GITHUB_PERSONAL_ACCESS_TOKEN"
### CONTEXT7_PLUGIN - the context7 plugin (library documentation for the agent), CONTEXT7_PLUGIN=false|true. Its remote
### MCP server needs an OAuth sign-in, so with it on every new terminal opened on "1 MCP server needs authentication";
### off by default. Set true and restart, then run /mcp in the agent's terminal once to sign in - the sign-in persists
### in the agent state.
export CONTEXT7_PLUGIN=false
### CLAUDE_MEM_PUBLIC_URL - the address claude-mem prints as "View Observations Live @ ..." at every session start:
### its viewer as the browser reaches it, the proxied claude-mem.localhost route on the home port (claude-mem would
### print http://localhost:37700, a port the harness does not publish)
export CLAUDE_MEM_PUBLIC_URL=http://claude-mem.localhost:${PORT_EXTERNAL_HOME}
### PLUGIN_ENV_OPTS - passes the Claude Code plugin settings to the container
export PLUGIN_ENV_OPTS="-e CONTEXT7_PLUGIN=$(shq "${CONTEXT7_PLUGIN}") -e CLAUDE_MEM_PUBLIC_URL=$(shq "${CLAUDE_MEM_PUBLIC_URL}")"
### GIT_USER_NAME / GIT_USER_EMAIL - the agent's git identity [recommended]: written as the container's git configuration
### (user.name, user.email) at every start by /agent/git-identity.sh, so a commit the agent makes carries it. Unset: the
### agent cannot commit - a thin wrapper ahead of the system git refuses a commit with one line naming these two variables,
### and no placeholder author is ever written: the agent runner's own placeholder ("Vibe Kanban", a noreply address at
### its project's domain, which it writes into a repository's configuration when there is no identity) is refused too.
export GIT_USER_NAME=""
export GIT_USER_EMAIL=""
### VK_RUNNER_AUTO_COMMIT - the agent runner's automatic commit, VK_RUNNER_AUTO_COMMIT=false|true [default false]: when a
### coding agent's turn ends with changes it did not commit, the runner (vibe-kanban) commits them itself, with the
### agent's last reply as the message. false: the git wrapper refuses that commit with one line, and the changes stay in
### the workspace for the agent (the runner asks it to commit them, with a message of its own) or you to commit; the
### runner's Merge action still commits its squash merge. true: the runner commits them as it does upstream.
export VK_RUNNER_AUTO_COMMIT=false
export GIT_IDENTITY_ENV_OPTS="-e GIT_USER_NAME -e GIT_USER_EMAIL -e VK_RUNNER_AUTO_COMMIT"
### RUN_OPTS [optional] - additional options to specify with the run comman. Example -e POSTGRES_DB=dbname
export AGENT_ENV_OPTS="-e http_proxy=$(shq "${http_proxy}") -e https_proxy=$(shq "${https_proxy}") -e no_proxy=$(shq "${no_proxy}") ${GIT_IDENTITY_ENV_OPTS} ${AWS_ENV_OPTS} ${AGENT_MODEL_ENV_OPTS} ${AUTONOMY_ENV_OPTS} ${AGENT_TMUX_ENV_OPTS} ${SPOKE_ENV_OPTS} ${SLACK_ENV_OPTS} ${UI_ENV_OPTS} ${COMMS_ENV_OPTS} ${AGENT_LEARNING_ENV_OPTS} ${GITHUB_ENV_OPTS} ${PLUGIN_ENV_OPTS} ${KUBE_ENV_OPTS}"
### --security-opt no-new-privileges: no process in the agent container gains privileges through a setuid or setgid
### binary (compose: security_opt; kubernetes: allowPrivilegeEscalation false)
export RUN_OPTS="--security-opt no-new-privileges ${AGENT_ENV_OPTS} ${AGENT_STATE_VOL_MAP}"
### TEST_RUN_OPTS - what test.sh gives the throwaway test container: the same environment, WITHOUT the agent-state
### mounts. The tests fire claude headless (test3), write memories through the hooks (test15) and index sessions
### (test9/16); with the persisted state mounted, those landed in the user's own agent state - a `-tmp-loop-smoke`
### project showed up in the LogLearner dashboard of a fresh deploy. The test container works on the image's baked
### copy of that state (plugins, settings, hooks, the initialised memory database) and throws it away. Its own
### HINDSIGHT_HOME and LOGLEARNER_STATE keep the memory database and the LogLearner index (ui-start.sh derives the
### index path from LOGLEARNER_STATE) test-local; TEST_VOL_MAP above keeps /wd itself throwaway.
### TMUX_AGENT_HOME as well: tmux-session-start.sh writes a session's capture log there (default /wd/tmux-agent-home).
### The suite's own knobs pass through when set on the host (a bare -e VAR passes a variable only when it is set):
### TEST6_UNITTEST_TIMEOUT=<seconds> ./test.sh raises test6's cap on the comms engine suite on a loaded host.
### The spokes' flags go false: seven spokes ship on for a real start, while the test container starts no spoke (each test
### starts the sessions it tests); with spokes on and no supervisor running, ui-status.sh rightly reports the supervisor
### DOWN, which every test that expects all UIs up would count. The last -e of a name is the one docker keeps.
export TEST_RUN_OPTS="${AGENT_ENV_OPTS} -e TEST_CONTAINER=true -e HINDSIGHT_HOME=/tmp/hindsight-test-home -e LOGLEARNER_STATE=/tmp/loglearner-test-state -e TMUX_AGENT_HOME=/tmp/tmux-agent-test-home -e TEST6_UNITTEST_TIMEOUT -e SPOKE_CONVERSATIONS=false -e SPOKE_INSIGHTS=false -e SPOKE_CLUSTERS=false -e SPOKE_SESSIONS=false -e SPOKE_LOOPS=false -e SPOKE_ISSUES=false -e SPOKE_DOCKER=false -e SPOKE_EXAMPLE=false"
### KNOWLEDGE_DIR too: claude-settings-sync.sh, which the tests and startup.sh (test6, test10) run, writes the default
### knowledge copy there (default /wd/knowledge).
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e KNOWLEDGE_DIR=/tmp/knowledge-test-home"
### FILES_DIR too: ui-start.sh creates the Files tile's shared folder (default /wd/files) whenever the tile is on, so a
### test that starts the UIs with the shipped defaults would write it under /wd.
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e FILES_DIR=/tmp/files-test-home"
### OVERLAY_DIR too: claude-settings-sync.sh, which the tests run, ends with the overlay stub (claude-overlay.sh), written
### at /wd/CLAUDE.md when none is there; the test container's folder for it does not exist, so the stub is skipped there
### (test-parity-inventory.sh proves the stub in folders of its own)
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e OVERLAY_DIR=/tmp/overlay-test-home"
### GOAL_WATCH=false too: startup.sh, which tests run (test6, test10, test-comms-defaults), starts the goal watcher in the
### background, which keeps its state under /wd/loop (AUTONOMY_LOOP_DIR) and outlives the test that started it
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e GOAL_WATCH=false"
### Plane board settings - the self-hosted Plane project-management board served at plane.localhost (docs/manual/boards.md
### "Plane board"); optional and OFF by default (AGPL-3.0, see UI_PLANE above), on with UI_PLANE=true in .env.local.
### On, ./build.sh pulls its public images (./plane.sh pull); ./run.sh runs its
### twelve services as sidecar containers on their own network, which the agent container joins, and on every start
### seeds the admin, the workspace, this instance's project and the agent's API token (no setup wizard); ./stop.sh
### removes the sidecars and keeps the board's data volumes. No sidecar publishes a host port: the board is reached
### only through the home proxy. The agent's autonomy loop mirrors its goals and fires as work items
### (/agent/plane-sync.py).
### PLANE_RELEASE and the images - Plane community v1.4.2 and the datastores of its docker compose file. The MinIO
### image is the one Plane's next release (v1.4.3) ships: minio/minio can no longer be pulled (makeplane/plane#9834)
export PLANE_RELEASE=v1.4.2
export PLANE_BACKEND_IMAGE=makeplane/plane-backend:${PLANE_RELEASE}
export PLANE_FRONTEND_IMAGE=makeplane/plane-frontend:${PLANE_RELEASE}
export PLANE_SPACE_IMAGE=makeplane/plane-space:${PLANE_RELEASE}
export PLANE_ADMIN_IMAGE=makeplane/plane-admin:${PLANE_RELEASE}
export PLANE_LIVE_IMAGE=makeplane/plane-live:${PLANE_RELEASE}
export PLANE_PROXY_IMAGE=makeplane/plane-proxy:${PLANE_RELEASE}
export PLANE_POSTGRES_IMAGE=postgres:15.7-alpine
export PLANE_REDIS_IMAGE=valkey/valkey:7.2.11-alpine
export PLANE_MQ_IMAGE=rabbitmq:3.13.6-management-alpine
export PLANE_MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
### PLANE_WORKER_CONCURRENCY - processes of the board's Celery worker; PLANE_MQ_SCHEDULERS - Erlang schedulers of its
### RabbitMQ. Upstream's default for both is one per host CPU: on a 96-CPU host that is 96 worker processes (about
### 6 GiB) and 96 schedulers that spin while idle (several cores of CPU). A single-instance board needs 2 of each
export PLANE_WORKER_CONCURRENCY=2
export PLANE_MQ_SCHEDULERS=2
### PLANE_NAME - prefix of the sidecar containers (<prefix>-api, <prefix>-web, ...), their networks and volumes
export PLANE_NAME=${CONTAINER}-plane
### PLANE_NETWORK - the network the agent container joins; only the board's proxy is on it too.
### PLANE_INTERNAL_NETWORK - the board's services, its proxy included; the agent is not on it, so no other board
### container can reach the agent
export PLANE_NETWORK=${PLANE_NAME}
export PLANE_INTERNAL_NETWORK=${PLANE_NAME}-internal
### PLANE_DIR - host folder of plane.env (mode 600: the admin login, the agent's API key and the server secrets,
### generated on the first ./run.sh) and of the per-service env files derived from it. Under wd/, so it is gitignored
### and visible to the agent at /wd/plane; no script prints its values.
export PLANE_DIR=$(pwd)/wd/plane
### PLANE_WORKSPACE / PLANE_PROJECT_IDENTIFIER - the seeded workspace (its slug) and the identifier of this instance's
### project in it (named after CONTAINER, with spaces for the characters Plane refuses in a project name, such as -);
### the agent's goals become its work items AGENT-1, AGENT-2, ...
export PLANE_WORKSPACE=do-agent-aws
export PLANE_PROJECT_IDENTIFIER=AGENT
### PLANE_LOGIN_BYPASS - the home page's Plane tile signs the browser in as the seeded admin, PLANE_LOGIN_BYPASS=true|false:
### a server-side sign-in behind the home proxy, answered only on the plane.localhost host route (so only through the
### loopback home port); false = Plane's own login page (the login is in plane.env)
export PLANE_LOGIN_BYPASS=true
### PORT_INTERNAL_PLANE_SIGNIN - the in-container loopback port of that sign-in helper (never published)
export PORT_INTERNAL_PLANE_SIGNIN=8090
### PLANE_URL - the Plane proxy as the agent container reaches it (the home proxy routes plane.localhost to it, the
### goal mirror writes to it); empty when the board is off. Computed - not usually edited by hand.
### PLANE_RUN_OPTS - what the agent container needs to use the board: the sidecar network, that URL, the workspace and
### project the mirror writes, and the login file. Appended by run.sh only - test.sh's throwaway container has no
### sidecars, and there the Plane tile says so.
export PLANE_URL=""
export PLANE_RUN_OPTS=""
if [ "${UI_START}" == "true" ] && [ "${UI_PLANE}" == "true" ]; then
  export PLANE_URL=http://plane-proxy:80
  export PLANE_RUN_OPTS="--network ${PLANE_NETWORK} -e PLANE_URL=$(shq "${PLANE_URL}") -e PLANE_WORKSPACE=$(shq "${PLANE_WORKSPACE}") -e PLANE_PROJECT=$(shq "${PLANE_PROJECT_IDENTIFIER}") -e PLANE_AUTH_FILE=/wd/plane/plane.env -e PLANE_LOGIN_BYPASS=$(shq "${PLANE_LOGIN_BYPASS}") -e UI_PORT_PLANE_SIGNIN=$(shq "${PORT_INTERNAL_PLANE_SIGNIN}")"
fi
### Docker build substrate settings - with SPOKE_DOCKER=true, ./run.sh (docker target) starts two sidecar containers
### before the agent and ./stop.sh removes them (./docker.sh, docs/manual/agents.md "Docker agent"): a rootless BuildKit daemon,
### DOCKER_BUILDKIT_NAME, and a registry, DOCKER_REGISTRY_NAME; ./build.sh pulls both pinned images. No host port is
### published and no host Docker socket is mounted anywhere: the daemon runs as an unprivileged user and listens on a
### unix socket on a small tmpfs volume, which the agent container mounts at /run/buildkit. buildctl in the agent
### (/agent/image-build.sh) builds through that socket and pushes to the registry, which answers as registry:5000 on the
### stack's networks. The daemon shares DOCKER_BUILD_NETWORK with the registry (with egress, for base images); the agent
### shares DOCKER_NETWORK, an internal network, with the registry alone, so no build step can reach the agent. The build
### cache and the pushed images stay in their volumes across ./stop.sh && ./run.sh (docker volume rm deletes them). The
### compose, swarm and kubernetes targets run no substrate, and the docker spoke says so.
### DOCKER_BUILDKIT_IMAGE / DOCKER_REGISTRY_IMAGE - the two public images, pinned: BuildKit's rootless release image (the
### agent image's buildctl is the same release, Container-Root/setup/install-buildctl.sh) and the distribution
### registry's current release line, 3.x (the 2.x line's last release dates from 2023)
export DOCKER_BUILDKIT_IMAGE=moby/buildkit:v0.35.0-rootless@sha256:5987568f92dafbfb679879de59c1cd8d26597f5f6635c314e166164e2615870c
export DOCKER_REGISTRY_IMAGE=registry:3.1.2@sha256:82f6ff4a7f982960c8aa51617fea3aabc485df6e55cce80d22deb1de36f1bc3c
### The sidecars', networks' and volumes' names (docker target), derived from CONTAINER
export DOCKER_BUILDKIT_NAME=${CONTAINER}-buildkit
export DOCKER_REGISTRY_NAME=${CONTAINER}-registry
export DOCKER_NETWORK=${CONTAINER}-docker
export DOCKER_BUILD_NETWORK=${CONTAINER}-docker-build
export DOCKER_SOCKET_VOLUME=${CONTAINER}-buildkit-socket
export DOCKER_CACHE_VOLUME=${CONTAINER}-buildkit-cache
export DOCKER_REGISTRY_VOLUME=${CONTAINER}-registry-data
### DOCKER_MIN_FREE_GB - the free disk (GB) wanted where Docker keeps the build cache and the registry's images; under
### it the docker spoke tells agent and the setup doctor's docker check is a gap
export DOCKER_MIN_FREE_GB=20
### DOCKER_RUN_OPTS - what the docker target's agent container needs to use the substrate: the socket volume, the
### daemon's address as buildctl reads it (BUILDKIT_HOST), the registry's (BUILD_REGISTRY) and the disk threshold.
### Appended by run.sh only, which also connects the running agent to DOCKER_NETWORK - test.sh's throwaway container
### has no sidecars. Empty while the docker spoke is off. Computed - not usually edited by hand.
export DOCKER_RUN_OPTS=""
if [ "${SPOKE_DOCKER}" == "true" ]; then
  export DOCKER_RUN_OPTS="--mount type=volume,src=$(shq "${DOCKER_SOCKET_VOLUME}"),dst=/run/buildkit -e BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock -e BUILD_REGISTRY=registry:5000 -e DOCKER_MIN_FREE_GB=$(shq "${DOCKER_MIN_FREE_GB}")"
fi
### VIBE_KANBAN_DATA_HOME too: the tests start their own agent runner, which on its start marks every agent run of
### its database failed; ui-start.sh gives it this throwaway data home instead of /home/agent/.local/share/vibe-kanban.
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e VIBE_KANBAN_DATA_HOME=/tmp/vibe-kanban-test-home"
### LOOP_DECK_DATA_DIR too: every UI start (ui-start.sh) and every loop fire (loop.sh) runs loop-deck-adapter.py, which
### writes the Loop Deck's inputs and its rendered page under /wd/loop-deck by default - the throwaway /wd the suite
### fails on; ui-start.sh serves the tests' Deck from this throwaway data directory instead.
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e LOOP_DECK_DATA_DIR=/tmp/loop-deck-test-data"
### TMUX_AGENT_SRC and TMUX_AGENT_INSTALL_DIR too: UI_ENV_OPTS passes the TMUX_AGENT_SRC set above, so every UI start
### in the test container ran the first-start build (git fetch, npm ci, npm run build) into /wd/tmux-agent and
### test16 met /tmux-agent/ with a 502 before it ended. The test container serves the vendored build (test14 checks
### 4-9), and a build a test does run lands in a throwaway install directory; test14 check 12 builds from a source
### when test14 is run with a reachable TMUX_AGENT_SRC exported.
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e TMUX_AGENT_SRC= -e TMUX_AGENT_INSTALL_DIR=/tmp/tmux-agent-test-install"
### AGENT_SECRETS_ID blank too: the suite never reads the operator's secret. Tests run startup.sh, whose loader
### (/agent/secrets-load.sh) would fetch it and write the file every later docker-exec script sources, so the values in
### the secret would replace the credentials a test sets itself (a blank token, a stub's). test-secrets-load.sh tests
### the loader against a stub aws CLI.
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e AGENT_SECRETS_ID="
### The Slack tests drive the watcher with planted senders against a local stub: their test container admits every
### person (anyone) as the watcher did before SLACK_ALLOWED_USERS; test-slack-senders.sh proves the shipped empty
### default and a named list on its own
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e SLACK_ALLOWED_USERS=anyone"
### STARTER_REPO_ROOT too: startup.sh makes the starter repository (starter-repo.sh) under its workspace root, so every
### test that runs startup.sh as shipped (test-comms-defaults.sh, test10.sh) left the 44 entries of /wd/projects/scratch
### in the throwaway /wd, and test16's last check and the end-of-suite /wd check counted them; the test container's starter
### repository lands in a throwaway root instead (test6 and test-starter-repo.sh set their own roots and are unaffected).
export TEST_RUN_OPTS="${TEST_RUN_OPTS} -e STARTER_REPO_ROOT=/tmp/starter-repo-test"

## compose
### DOCKER_COMPOSE - docker-compose cli, DOCKER_COMPOSE=docker-compose | "docker compose"
export DOCKER_COMPOSE="docker-compose"
### COMPOSE_PROJECT_NAME - prefix for project containers, example COMPOSE_PROJECT_NAME=compose
export COMPOSE_PROJECT_NAME=compose
### COMPOSE_TEMPLATE - compose file template path
export COMPOSE_TEMPLATE=./to/compose/template/docker-compose.yaml
### COMPOSE_FILE - compose file path
export COMPOSE_FILE=./to/compose/app/docker-compose.yaml
### COMPOSE_KANBAN_TEMPLATE / COMPOSE_KANBAN_FILE - the kanban board's services (docs/manual/boards.md "Kanban board"): an
### overlay that run.sh renders and adds with -f only while the board is on, so the base file stays a valid swarm stack
export COMPOSE_KANBAN_TEMPLATE=./to/compose/template/docker-compose.kanban.yaml
export COMPOSE_KANBAN_FILE=./to/compose/app/docker-compose.kanban.yaml
### COMPOSE_KANBAN_RELAY_TEMPLATE / COMPOSE_KANBAN_RELAY_FILE - the board's relay (UI_KANBAN_RELAY=true): a second
### overlay, rendered and added with -f only while the relay is on
export COMPOSE_KANBAN_RELAY_TEMPLATE=./to/compose/template/docker-compose.kanban-relay.yaml
export COMPOSE_KANBAN_RELAY_FILE=./to/compose/app/docker-compose.kanban-relay.yaml

## swarm
### SWARM_STACK_NAME - name of the application stack to deploy, similar to COMPOSE_PROJECT_NAME
export SWARM_STACK_NAME=mystack
### SWARM_SERVICE_NAME - a stack may contain many services. The action scripts are executed agains the service name configured here.
export SWARM_SERVICE_NAME=${CONTAINER}

## kubernetes
### KUBECTL - kubectl cli, KUBECTL=kubectl
export KUBECTL=kubectl
### KUBETAIL - kubetail cli, KUBETAIL=kubetail
export KUBETAIL=kubetail
### KUBERNETES_TEMPLATE_PATH - folder containing Kubernetes manifest templates
export KUBERNETES_TEMPLATE_PATH=./to/kubernetes/template
### KUBERNETES_APP_PATH - folder containing Kubernetes manifests
export KUBERNETES_APP_PATH=./to/kubernetes/app
### KUBERNETES_INGRESS - render and apply the Ingress (to/kubernetes/template/050-ingress.yaml), KUBERNETES_INGRESS=false|true.
### Off by default: it routes plain HTTP to the home proxy - the writable terminal, the memory API - with no
### authentication in front, and the proxy refuses ingress traffic anyway until UI_HOME_ALLOW_FROM and UI_HOME_HOSTNAMES
### open it. Turn it on only behind an authenticating front end (for example an ALB with OIDC, SECURITY.md); reach the
### UIs with kubectl port-forward otherwise. Turning it off after it was applied: ./stop.sh first, or delete the Ingress
export KUBERNETES_INGRESS=false
### KUBERNETES_HPA - render and apply the HorizontalPodAutoscaler (040-hpa.yaml), KUBERNETES_HPA=false|true. Off by
### default: the harness runs one replica (a second would be a second agent with its own loop and Slack responder)
export KUBERNETES_HPA=false
### APP_NAME - name of the appliation to deploy
export APP_NAME=${CONTAINER}
### APP_DNS_NAME - fully qualified domain name for the application
export APP_DNS_NAME=${CONTAINER}.domain.ext
### NAMESPACE - Kubernetes namespace where the app will run
export NAMESPACE=${APP_NAME}
### INSTANCE_TYPE - optional instance type on which application pods should run. To use, uncomment deployment template nodeSelector section.
export INSTANCE_TYPE=m5.8xlarge

## sandbox
### TO=sandbox - the harness in a Docker Sandboxes microVM, created from the kit in to/sandbox (to/sandbox/README.md
### "TO=sandbox"): ./build.sh renders the kit from HEAD and builds it, ./run.sh creates the sandbox, ./status.sh lists
### it, ./exec.sh opens a shell in it or runs a command there, ./stop.sh removes it and ./logs.sh says where the agent's
### output is. The sandbox runs the kit image's own environment: the settings above do not reach it, and no UI or
### board sidecar starts in it. The sign-in, the policy and the model credential stay the target's own steps.
### SBX - the Docker Sandboxes cli, SBX=sbx
export SBX=sbx
### SANDBOX_NAME - the sandbox's name (sbx create --name), as CONTAINER names the docker target's container
export SANDBOX_NAME=${IMAGE}
### SANDBOX_KIT - the kit directory to/sandbox/render.sh writes and sbx create builds and creates from; a relative path must
### start with ./ (otherwise sbx reads it as a registry or agent name)
export SANDBOX_KIT=./to/sandbox/app/do-agent-aws-sandbox
### SANDBOX_DESCRIPTOR - the kit descriptor whose resources@1 gives the sandbox's --cpus and --memory; the sizes have that
### one source (to/sandbox/README.md), read at build and at run
export SANDBOX_DESCRIPTOR=./to/sandbox/template/do-agent-aws-sandbox.yaml
### SANDBOX_CREATE_OPTS - further arguments for sbx create; --skills off keeps the host's skills store out of the sandbox
export SANDBOX_CREATE_OPTS="--skills off"
### SANDBOX_PREBUILD_NAME - the throwaway sandbox ./build.sh creates to build the kit and removes at once, so that ./run.sh
### reuses the build
export SANDBOX_PREBUILD_NAME=${SANDBOX_NAME}-prebuild


# Your settings: .env.local beside this file (gitignored; docs/manual/install.md "Settings"), lines of export NAME=value that
# replace these defaults. It is read after them, and then this file once more with each of its names kept as it set
# them, so every value derived here from one of your settings (UI_ENV_OPTS, the port and volume maps, RUN_OPTS,
# TEST_RUN_OPTS) follows yours. ./run.sh and ./build.sh create it on their first run (./env-local.sh).
if [ -z "${ENV_LOCAL_FILE:-}" ] && [ -f "$(dirname "${BASH_SOURCE[0]}")/.env.local" ]; then
  ENV_LOCAL_FILE="$(dirname "${BASH_SOURCE[0]}")/.env.local"
  ENV_LOCAL_NAMES=" $(sed -n -E 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/\2/p' "${ENV_LOCAL_FILE}" | tr '\n' ' ')"
  source "${ENV_LOCAL_FILE}"
  for ENV_LOCAL_NAME in ${ENV_LOCAL_NAMES}; do builtin export "${ENV_LOCAL_NAME}"; done
  # the second pass: an export of one of your names leaves your value
  export()
  {
    local A
    for A in "$@"; do
      case "${A}" in
        *=*) case "${ENV_LOCAL_NAMES}" in *" ${A%%=*} "*) continue ;; esac ;;
      esac
      builtin export "${A}"
    done
  }
  source "${BASH_SOURCE[0]}"
  unset -f export
  unset ENV_LOCAL_FILE ENV_LOCAL_NAMES ENV_LOCAL_NAME
fi
